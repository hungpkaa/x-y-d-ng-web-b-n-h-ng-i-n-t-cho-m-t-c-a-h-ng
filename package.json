{
  "name": "electro-store",
  "version": "0.1.0",
  "private": true,
  "description": "Website bán đồ điện tử — Node.js, Express, SQLite",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "catalog:images": "node scripts/prepare-catalog-images.js",
    "catalog:expand": "node scripts/expand-demo-catalog.js",
    "catalog:import": "node --env-file-if-exists=.env scripts/import-demo-catalog.js",
    "catalog:fill-images": "node --env-file-if-exists=.env scripts/fill-product-images.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "test:smoke": "node scripts/smoke.js",
    "integrations:check:sample": "node scripts/check-integrations.js --sample",
    "db:check": "node --env-file-if-exists=.env scripts/check-postgres.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-postgres.js",
    "db:import": "node --env-file-if-exists=.env scripts/import-sqlite-to-postgres.js",
    "test:postgres": "node --env-file-if-exists=.env scripts/run-postgres-checks.js",
    "test:smoke:postgres": "node --env-file-if-exists=.env scripts/smoke.js --postgres"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
