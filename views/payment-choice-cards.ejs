<div class="payment-choice-cards" role="group" aria-label="Chọn phương thức thanh toán" hidden><button type="button" data-payment-choice="COD" aria-pressed="<%= method==='COD' %>"><span class="payment-choice-symbol">COD</span><span><strong>Trả tiền khi nhận hàng</strong><small>Thanh toán khi đơn được giao</small></span><i aria-hidden="true"></i></button><button type="button" data-payment-choice="BANK_TRANSFER" aria-pressed="<%= method==='BANK_TRANSFER' %>"><span class="payment-choice-symbol">QR</span><span><strong>Chuyển khoản BIDV</strong><small>Quét QR · Cửa hàng xác nhận tiền</small></span><i aria-hidden="true"></i></button><% if(onlineAvailable) { %><button type="button" data-payment-choice="ONLINE" aria-pressed="<%= method==='ONLINE' %>"><span class="payment-choice-symbol">VN</span><span><strong>VNPay sandbox</strong><small>Môi trường thanh toán thử nghiệm</small></span><i aria-hidden="true"></i></button><% } %></div>
