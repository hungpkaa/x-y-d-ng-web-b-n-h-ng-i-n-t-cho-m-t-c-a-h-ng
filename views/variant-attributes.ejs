<% if(v.attributes.length) { %><details><summary>Thông số kỹ thuật</summary><form method="post" action="/admin/variants/<%= v.id %>/attributes"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= v.version %>"><div class="formgrid">
<% v.attributes.forEach(d=>{ %><label><%= d.label %><%= d.unit?' ('+d.unit+')':'' %><%= d.required?' · Bắt buộc khi bán':'' %>
<% if(d.data_type==='BOOLEAN') { %><select name="attr_<%= d.id %>"><option value="">Chưa nhập</option><option value="1" <%= d.value_boolean===1?'selected':'' %>>Có</option><option value="0" <%= d.value_boolean===0?'selected':'' %>>Không</option></select><% } else { %><input name="attr_<%= d.id %>" type="<%= d.data_type==='NUMBER'?'number':'text' %>" <%- d.data_type==='NUMBER'?'step="any"':'' %> maxlength="500" value="<%= d.data_type==='NUMBER'?(d.value_number??''):(d.value_text??'') %>"><% } %></label><% }) %></div><button>Lưu thông số</button></form></details><% } else { %><p>Danh mục chưa có định nghĩa thông số. Quản trị viên có thể thêm tại mục Thông số kỹ thuật.</p><% } %>
