<h1>Quản lý khuyến mãi</h1><a class="button" href="/admin/promotions/new">Tạo mã giảm giá</a> <a href="/admin">← Quản lý</a>
<form class="filters" method="get" action="/admin/promotions"><label>Mã<input name="q" maxlength="100" value="<%= filters.q %>"></label><label>Trạng thái<select name="active"><option value="">Tất cả</option><option value="1" <%= filters.active==='1'?'selected':'' %>>Đang bật</option><option value="0" <%= filters.active==='0'?'selected':'' %>>Đã tắt</option></select></label><button>Lọc</button></form>
<% rows.forEach(p=>{ %><a class="row panel" href="/admin/promotions/<%= p.id %>"><strong><%= p.code %></strong><span><%= p.kind==='FIXED'?money(p.value):p.value+'%' %> · <%= p.active?'Đang bật':'Đã tắt' %></span><span>Đã giữ/dùng <%= p.occupied %>/<%= p.total_limit %></span><small><%= promotionTime(p.starts_at).replace('T',' ') %> → <%= promotionTime(p.ends_at).replace('T',' ') %> (UTC+7)</small></a><% }) %><% if(!rows.length) { %><p>Chưa có mã phù hợp.</p><% } %><%- include('record-pagination',{recordLabel:'mã giảm giá'}) %>
