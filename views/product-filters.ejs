<form class="filters" method="get" action="<%= management?'/admin':'/' %>">
<input name="q" value="<%= q %>" placeholder="Tìm sản phẩm hoặc thương hiệu" aria-label="Tìm kiếm">
<select name="category" aria-label="Danh mục"><option value="">Tất cả danh mục</option><% (management?catalogCategories.map(c=>({category:c.name})):categories).forEach(c=>{ %><option value="<%= c.category %>" <%= category===c.category?'selected':'' %>><%= c.category %></option><% }) %></select>
<select name="brand" aria-label="Thương hiệu"><option value="">Tất cả thương hiệu</option><% (management?catalogBrands.map(b=>({brand:b.name})):brands).forEach(b=>{ %><option value="<%= b.brand %>" <%= brand===b.brand?'selected':'' %>><%= b.brand %></option><% }) %></select>
<input name="min" type="number" min="0" max="1000000000" value="<%= min %>" placeholder="Giá từ (VND)" aria-label="Giá tối thiểu"><input name="max" type="number" min="0" max="1000000000" value="<%= max %>" placeholder="Giá đến (VND)" aria-label="Giá tối đa">
<select name="sort" aria-label="Sắp xếp"><option value="newest" <%= sort==='newest'?'selected':'' %>>Mới nhất</option><option value="price_asc" <%= sort==='price_asc'?'selected':'' %>>Giá tăng dần</option><option value="price_desc" <%= sort==='price_desc'?'selected':'' %>>Giá giảm dần</option></select>
<% if(management) { %><select name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><% Object.entries({DRAFT:'Bản nháp',ACTIVE:'Đang bán',HIDDEN:'Đã ẩn'}).forEach(([key,label])=>{ %><option value="<%= key %>" <%= productStatus===key?'selected':'' %>><%= label %></option><% }) %></select><% } %><button>Lọc sản phẩm</button></form>
