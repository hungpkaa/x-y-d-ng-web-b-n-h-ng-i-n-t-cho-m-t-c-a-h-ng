<aside class="admin-sidebar" aria-label="Điều hướng quản trị"><h2><%= user.role==='ADMIN'?'Quản trị cửa hàng':'Nhân viên cửa hàng' %></h2>
<% const links=[['/admin/dashboard','Tổng quan'],['/admin','Sản phẩm & ảnh'],['/admin/orders','Đơn hàng'],['/admin/shipments','Vận chuyển'],['/admin/support','Hỗ trợ']]; if(user.role==='ADMIN') links.push(['/admin/accounts','Khách hàng & nhân viên'],['/admin/catalog','Danh mục & thương hiệu'],['/admin/attributes','Thông số kỹ thuật'],['/admin/promotions','Khuyến mãi'],['/admin/reviews','Duyệt đánh giá'],['/admin/shipping','Phí giao hàng'],['/admin/refunds','Hoàn tiền'],['/admin/reports','Báo cáo'],['/admin/audit','Nhật ký']); %>
<nav><% links.forEach(([url,label])=>{const selected=url==='/admin'?managementPath==='/admin'||managementPath.startsWith('/admin/products'):managementPath===url||managementPath.startsWith(url+'/'); %><a href="<%= url %>" <%- selected?'aria-current="page"':'' %>><%= label %></a><% }); %></nav><a class="button" href="/admin#add-product">+ Thêm sản phẩm</a></aside>
