<h1>Đối soát chuyển khoản</h1><p class="configuration-help">Chỉ xác nhận sau khi kiểm tra giao dịch thực nhận tại ngân hàng. Đơn hết hạn vẫn xuất hiện trong danh sách chờ để xử lý tiền đến muộn.</p>
<form class="filters" method="get" action="/admin/bank-transfers"><label>Mã đơn / nội dung chuyển khoản<input name="q" value="<%= filters.q %>" maxlength="100" placeholder="Ví dụ: DH15 hoặc 15"></label><label>Đối soát<select name="state"><option value="WAITING" <%= filters.state==='WAITING'?'selected':'' %>>Chưa ghi nhận tiền</option><option value="RECORDED" <%= filters.state==='RECORDED'?'selected':'' %>>Đã ghi nhận tiền</option><option value="ALL" <%= filters.state==='ALL'?'selected':'' %>>Tất cả</option></select></label><button>Lọc danh sách</button></form>
<% if(!rows.length) { %><section class="empty-state"><h2>Không có đơn phù hợp</h2><p>Thử đổi bộ lọc hoặc tìm theo nội dung chuyển khoản.</p></section><% } %>
<% rows.forEach(row=>{ const expired=row.expires_at<=Date.now(); %><article class="panel order-list-card"><div class="order-list-heading"><strong>Đơn #<%= row.id %> · <%= row.transfer_reference %></strong><span class="order-status-badge"><%= labels[row.status] %></span></div><div class="order-list-body"><div><p>Người nhận hàng: <%= row.recipient %></p><p>Thanh toán: <strong><%= {PENDING:'Chờ xác nhận',UNPAID:'Chưa thu tiền',PAID:'Đã thu tiền',REFUND_PENDING:'Chờ hoàn tiền',REFUNDED:'Đã hoàn tiền'}[row.payment_status]||row.payment_status %></strong></p><p class="configuration-help">Hạn xác nhận: <%= new Date(row.expires_at).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'}) %> (UTC+7)</p><% if((expired||row.status==='CANCELLED')&&['PENDING','UNPAID'].includes(row.payment_status)) { %><p class="cart-warning">Đơn đã hết hạn hoặc bị hủy. Xác nhận khoản tiền thực nhận sẽ ghi nghĩa vụ hoàn, không mở lại đơn.</p><% } %></div><div class="order-list-total"><small>Số tiền cần đối soát</small><strong><%= money(row.amount) %></strong><a class="button secondary" href="/orders/<%= row.id %>#bank-transfer">Xem và đối soát</a></div></div></article><% }) %>
<%- include('record-pagination',{recordLabel:'đơn chuyển khoản'}) %>
