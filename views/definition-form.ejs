<form method="post" action="/admin/attributes"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(d) { %><input type="hidden" name="id" value="<%= d.id %>"><input type="hidden" name="version" value="<%= d.version %>"><% } %><div class="formgrid">
<label>Danh mục<select name="category_id" required><% catalogCategories.forEach(c=>{ %><option value="<%= c.id %>" <%= d?.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Mã thông số<input name="code" value="<%= d?.code??'' %>" maxlength="60" pattern="[a-z][a-z0-9_]{0,59}" placeholder="ram_gb" required></label><label>Tên thông số<input name="label" value="<%= d?.label??'' %>" maxlength="120" placeholder="RAM" required></label>
<label>Kiểu dữ liệu<select name="data_type"><% Object.entries({TEXT:'Văn bản',NUMBER:'Số',BOOLEAN:'Có/Không'}).forEach(([key,label])=>{ %><option value="<%= key %>" <%= d?.data_type===key?'selected':'' %>><%= label %></option><% }) %></select></label><label>Đơn vị (chỉ kiểu số)<input name="unit" value="<%= d?.unit??'' %>" maxlength="30" placeholder="GB"></label><label>Bắt buộc khi bán<select name="required"><option value="0" <%= !d?.required?'selected':'' %>>Không</option><option value="1" <%= d?.required?'selected':'' %>>Có</option></select></label></div><button><%= d?'Lưu định nghĩa':'Thêm thông số' %></button></form>
