<% const selected=variants.find(v=>v.id===recommendation.anchor?.id); %>
<aside class="product-purchase-summary"><span class="category-eyebrow">LỰA CHỌN CỦA BẠN</span><h2><%= product.name %></h2><% if(selected) { %><p class="purchase-variant-name"><%= [selected.color,selected.configuration].filter(Boolean).join(' · ')||selected.sku %></p><div class="purchase-price-box"><small>Giá cấu hình đang chọn</small><strong><%= money(selected.price) %></strong><span class="purchase-availability <%= selected.stock>0?'available':'unavailable' %>"><%= selected.stock>0?'Có hàng · Còn '+selected.stock+' sản phẩm':'Tạm hết hàng' %></span></div><dl class="purchase-facts"><div><dt>Thương hiệu</dt><dd><%= product.brand %></dd></div><div><dt>Danh mục</dt><dd><%= product.category %></dd></div><div><dt>Mã cấu hình</dt><dd><%= selected.sku %></dd></div></dl><a class="button purchase-main-link" href="#sku-<%= selected.id %>"><%= selected.stock>0?'Chọn số lượng và thêm giỏ':'Xem cấu hình này' %> <span>→</span></a><a class="purchase-other-config" href="#product-configurations">Xem <%= variants.length %> cấu hình của sản phẩm</a><% } else { %><p class="configuration-help">Chưa có cấu hình đủ thông tin giá. Bạn có thể khám phá các sản phẩm khác trong danh mục.</p><a class="button secondary" href="/?category=<%= encodeURIComponent(product.category) %>">Xem sản phẩm khác</a><% } %><div class="purchase-service-note"><%- include('ui-icon',{name:'box'}) %><p>Giá, phí giao và mã giảm giá được kiểm tra trước khi xác nhận đơn.</p></div><div class="purchase-service-note"><%- include('ui-icon',{name:'compare'}) %><p>So sánh tối đa 3 cấu hình cùng danh mục trước khi lựa chọn.</p></div><%- include('product-engagement') %></aside>
