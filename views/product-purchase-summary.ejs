<% const selected=variants.find(v=>v.id===recommendation.anchor?.id); %>
<aside class="product-purchase-summary" id="purchase-panel" aria-labelledby="purchase-title"><span class="category-eyebrow">LỰA CHỌN CỦA BẠN</span><h2 id="purchase-title"><%= product.name %></h2>
<% if(selected) { %>
  <div class="purchase-price-box"><small>Giá cấu hình đang chọn</small><strong><%= money(selected.price) %></strong><span class="purchase-availability <%= selected.stock>0?'available':'unavailable' %>"><%= selected.stock>0?'Có hàng · Còn '+selected.stock+' sản phẩm':'Tạm hết hàng' %></span></div>
  <div class="purchase-config-label"><strong>Chọn phiên bản</strong><span><%= variants.length %> lựa chọn</span></div>
  <nav class="purchase-config-options" aria-label="Phiên bản sản phẩm"><% variants.forEach(v=>{ %><a href="/products/<%= product.id %>?sku=<%= v.id %>#purchase-panel" <%= selected.id===v.id?'aria-current=true':'' %>><strong><%= [v.color,v.configuration].filter(Boolean).join(' · ')||v.sku %></strong><span><%= money(v.price) %><%= v.stock>0?'':' · Hết hàng' %></span></a><% }); %></nav>
  <% if(!user||user.role==='CUSTOMER') { %><form method="post" action="/cart" class="purchase-add-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= selected.id %>"><input type="hidden" name="action" value="add"><%- include('quantity-control',{value:1,min:1,max:Math.max(1,Math.min(selected.stock,99)),quantityLabel:'Số lượng'}) %><button class="purchase-add-button" <%= selected.stock>0?'':'disabled' %>Thêm vào giỏ hàng <span aria-hidden="true">→</span></button></form><% } else { %><p class="configuration-help">Dùng tài khoản khách hàng riêng để mua sản phẩm.</p><% } %>
  <a class="purchase-other-config" href="#sku-<%= selected.id %>">Xem thông số cấu hình đang chọn ↓</a>
  <details class="purchase-code-details"><summary>Thông tin sản phẩm</summary><dl class="purchase-facts"><div><dt>Thương hiệu</dt><dd><%= product.brand %></dd></div><div><dt>Danh mục</dt><dd><%= product.category %></dd></div><div><dt>Mã cấu hình</dt><dd><%= selected.sku %></dd></div></dl></details>
<% } else { %><p class="configuration-help">Chưa có cấu hình đủ thông tin giá. Bạn có thể khám phá các sản phẩm khác trong danh mục.</p><a class="button secondary" href="/?category=<%= encodeURIComponent(product.category) %>">Xem sản phẩm khác</a><% } %>
<div class="purchase-service-note"><%- include('ui-icon',{name:'box'}) %><p>Giá, phí giao và mã giảm giá được kiểm tra trước khi xác nhận đơn.</p></div><%- include('product-engagement') %></aside>
