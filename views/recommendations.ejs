<%- include('discovery-heading',{current:'recommendations',icon:'search',title:'Gợi ý sản phẩm',description:'Thiết bị phù hợp bắt đầu từ nhu cầu của bạn. Chọn danh mục và ngân sách, khám phá những cấu hình còn hàng.'}) %>
<section class="panel recommendation-filter-card"><div><span class="category-eyebrow">TÌM LỰA CHỌN PHÙ HỢP</span><h2>Bạn đang tìm thiết bị nào?</h2><p class="auth-hint">Mỗi sản phẩm hiển thị một cấu hình phù hợp, tối đa 6 gợi ý.</p></div>
<form class="filters" method="get" action="/recommendations">
<% if(recommendation.source) { %><input type="hidden" name="source" value="<%= recommendation.source.id %>"><% if(recommendation.anchor) { %><input type="hidden" name="sku" value="<%= recommendation.anchor.id %>"><% } %><% } %>
<label>Danh mục<select name="category_id"><option value="">Tất cả</option><% options.categories.forEach(c=>{ %><option value="<%= c.id %>" <%= recommendation.filters.category_id===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label>
<label>Thương hiệu<select name="brand_id"><option value="">Tất cả</option><% options.brands.forEach(b=>{ %><option value="<%= b.id %>" <%= recommendation.filters.brand_id===String(b.id)?'selected':'' %>><%= b.name %></option><% }) %></select></label>
<label>Giá từ (VND)<input type="number" name="min" min="0" max="1000000000" step="1" value="<%= recommendation.filters.min %>"></label><label>Giá đến (VND)<input type="number" name="max" min="0" max="1000000000" step="1" value="<%= recommendation.filters.max %>"></label><button>Tìm gợi ý</button><a href="/recommendations">Xóa bộ lọc</a>
</form></section>
<%- include('recommendation-cards') %>
<p class="recommendation-explainer">Gợi ý dựa trên danh mục, thương hiệu, mức giá và số lượng đã giao. Khi chưa có lịch sử giao hàng, hệ thống giới thiệu sản phẩm đang bán và còn hàng.</p>
