<h1>Sổ địa chỉ</h1><a href="/profile">← Hồ sơ</a><p>Lưu tối đa 20 địa chỉ. Địa chỉ mặc định được điền sẵn khi mua; thay đổi ở đây không sửa đơn đã đặt.</p>
<% addresses.forEach(entry=>{ %><section class="panel"><h2><%= entry.label %><%= entry.is_default?' · Mặc định':'' %></h2><p><%= entry.recipient %> · <%= entry.phone %></p><p><%= entry.address %></p><details><summary>Sửa địa chỉ</summary><form method="post" action="/addresses/<%= entry.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= entry.version %>"><%- include('address-fields',{entry}) %><button>Lưu thay đổi</button></form></details><div class="row"><% if(!entry.is_default) { %><form method="post" action="/addresses/<%= entry.id %>/default"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= entry.version %>"><button class="secondary">Đặt mặc định</button></form><% } %><form method="post" action="/addresses/<%= entry.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= entry.version %>"><button class="secondary">Xóa địa chỉ</button></form></div></section><% }) %>
<% if(addresses.length<20) { %><section class="panel"><h2>Thêm địa chỉ</h2><form method="post" action="/addresses"><input type="hidden" name="_csrf" value="<%= csrf %>"><%- include('address-fields',{entry:null}) %><button>Thêm địa chỉ</button></form></section><% } %>
