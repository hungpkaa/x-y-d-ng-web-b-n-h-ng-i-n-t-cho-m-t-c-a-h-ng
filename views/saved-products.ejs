<h1><%= heading %></h1>
<% if(!favoriteList && (!user || user.role==='CUSTOMER')) { %><form method="post" action="/recent/clear"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Xóa lịch sử đã xem</button></form><% } %>
<% if(!rows.length) { %><p>Chưa có sản phẩm trong danh sách.</p><a class="button" href="/">Khám phá sản phẩm</a><% } %>
<div class="grid"><% rows.forEach(product=>{ %><article class="card"><% if(product.image_key) { %><div class="product-art"><img src="/media/<%= product.image_key %>" alt="<%= product.name %>" loading="lazy"></div><% } %><h2><a href="/products/<%= product.id %>"><%= product.name %></a></h2><p><%= product.brand %> · <%= product.category %></p><% if(product.display_price) { %><strong class="price">Từ <%= money(product.display_price) %></strong><% } %><p><a href="/products/<%= product.id %>">Xem cấu hình</a></p><% if(favoriteList) { %><form method="post" action="/favorites/<%= product.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Bỏ yêu thích</button></form><% } %></article><% }); %></div>
<% if(paging) { %><%- include('record-pagination',{recordLabel:'sản phẩm'}) %><% } %>
