<%- include('discovery-heading',{current:favoriteList?'favorites':'recent',icon:favoriteList?'user':'box',title:heading,description:favoriteList?'Giữ lại những thiết bị bạn yêu thích. Dễ dàng tìm lại khi sẵn sàng lựa chọn.':'Một lần khám phá, dễ dàng tìm lại. Các sản phẩm vừa xem được xếp gần nhất trước.'}) %>
<div class="discovery-page-toolbar"><p><%= paging?paging.total:rows.length %> sản phẩm <%= favoriteList?'đã lưu':'trong lịch sử' %></p><a href="/">Tiếp tục khám phá →</a></div>
<% if(!favoriteList && (!user || user.role==='CUSTOMER')) { %><form method="post" action="/recent/clear"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Xóa lịch sử đã xem</button></form><% } %>
<% if(!rows.length) { %><section class="empty-state"><h2><%= favoriteList?'Chưa có sản phẩm yêu thích':'Chưa có sản phẩm đã xem' %></h2><p><%= favoriteList?'Mở một sản phẩm và chọn “Lưu yêu thích” để thêm vào danh sách.':'Các sản phẩm bạn mở sẽ xuất hiện tại đây để dễ tìm lại.' %></p><a class="button" href="/">Khám phá sản phẩm</a></section><% } %>
<div class="grid catalog-grid saved-grid"><% rows.forEach(product=>{ %><article class="card saved-card discovery-saved-card"><% if(product.image_key) { %><div class="product-art"><img src="/media/<%= product.image_key %>" alt="<%= product.name %>" loading="lazy"></div><% } else { %><div class="product-art"><%- include('discovery-placeholder') %></div><% } %><h2><a href="/products/<%= product.id %>"><%= product.name %></a></h2><p><%= product.brand %> · <%= product.category %></p><% if(product.display_price) { %><strong class="price">Từ <%= money(product.display_price) %></strong><% } %><p><a class="button secondary" href="/products/<%= product.id %>">Xem cấu hình</a></p><% if(favoriteList) { %><form method="post" action="/favorites/<%= product.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Bỏ yêu thích</button></form><% } %></article><% }); %></div>
<% if(paging) { %><%- include('record-pagination',{recordLabel:'sản phẩm'}) %><% } %>
