<h1><%= heading %></h1>
<p class="configuration-help"><%= favoriteList?'Lưu lại thiết bị bạn quan tâm để dễ tìm và so sánh trước khi mua.':'Tìm lại những thiết bị bạn vừa khám phá. Giá và tình trạng bán có thể thay đổi.' %></p><nav class="order-filter-tabs" aria-label="Danh sách sản phẩm cá nhân"><% if(user?.role==='CUSTOMER') { %><a href="/favorites" <%= favoriteList?'aria-current=page':'' %>>Yêu thích</a><% } %><a href="/recent" <%= !favoriteList?'aria-current=page':'' %>>Đã xem</a><a href="/">Tiếp tục mua sắm</a></nav>
<% if(!favoriteList && (!user || user.role==='CUSTOMER')) { %><form method="post" action="/recent/clear"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Xóa lịch sử đã xem</button></form><% } %>
<% if(!rows.length) { %><section class="empty-state"><h2><%= favoriteList?'Chưa có sản phẩm yêu thích':'Chưa có sản phẩm đã xem' %></h2><p><%= favoriteList?'Mở một sản phẩm và chọn “Lưu yêu thích” để thêm vào danh sách.':'Các sản phẩm bạn mở sẽ xuất hiện tại đây để dễ tìm lại.' %></p><a class="button" href="/">Khám phá sản phẩm</a></section><% } %>
<div class="grid catalog-grid saved-grid"><% rows.forEach(product=>{ %><article class="card saved-card"><% if(product.image_key) { %><div class="product-art"><img src="/media/<%= product.image_key %>" alt="<%= product.name %>" loading="lazy"></div><% } else { %><div class="product-art saved-placeholder" aria-label="Chưa có ảnh">Electro Store</div><% } %><h2><a href="/products/<%= product.id %>"><%= product.name %></a></h2><p><%= product.brand %> · <%= product.category %></p><% if(product.display_price) { %><strong class="price">Từ <%= money(product.display_price) %></strong><% } %><p><a class="button secondary" href="/products/<%= product.id %>">Xem cấu hình</a></p><% if(favoriteList) { %><form method="post" action="/favorites/<%= product.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Bỏ yêu thích</button></form><% } %></article><% }); %></div>
<% if(paging) { %><%- include('record-pagination',{recordLabel:'sản phẩm'}) %><% } %>
