<div class="formgrid"><label>Tên địa chỉ<input name="label" value="<%= entry?.label||'' %>" maxlength="60" required placeholder="Nhà riêng / Công ty"></label><label>Người nhận<input name="recipient" value="<%= entry?.recipient||user.name %>" minlength="2" maxlength="80" autocomplete="name" required></label><label>Điện thoại<input name="phone" value="<%= entry?.phone||user.phone %>" type="tel" pattern="0[0-9]{9}" autocomplete="tel" required></label><label>Địa chỉ<textarea name="address" minlength="10" maxlength="300" autocomplete="street-address" required><%= entry?.address||'' %></textarea></label></div>
