<h1>Tổng quan cửa hàng</h1><p>Các công việc cần xử lý và tình hình hiện tại.</p>
<div class="dashboard-stats"><% const cards=[['Sản phẩm',stats.products,'/admin'],['Bản nháp',stats.drafts,'/admin?status=DRAFT'],['Chờ xác nhận',stats.pending,'/admin/orders?status=PENDING'],['Đang chuẩn bị',stats.preparing,'/admin/orders?status=PREPARING'],['Đang giao',stats.shipping,'/admin/orders?status=SHIPPING'],['SKU tồn thấp ≤5',stats.lowstock,'/admin'],['Yêu cầu hỗ trợ',stats.tickets,'/admin/support']]; cards.forEach(([label,value,url])=>{ %><a class="panel stat-card" href="<%= url %>"><span><%= label %></span><strong><%= value %></strong></a><% }); %></div>
<% if(report) { %><section class="panel"><h2>Tháng hiện tại · <%= report.filters.from %> → <%= report.filters.to %></h2><div class="dashboard-stats"><div><p>Doanh thu hàng đã giao và thu tiền</p><strong><%= money(report.summary.revenue) %></strong></div><div><p>Tiền thu trừ tiền hoàn</p><strong><%= money(report.summary.netCash) %></strong></div><div><p>Khoản đang chờ hoàn</p><strong><%= money(report.pendingRefunds) %></strong></div></div><a href="/admin/reports">Xem báo cáo đầy đủ và xuất CSV →</a></section><% } %>
<section class="panel"><h2>Đơn mới nhất</h2><% if(!latestOrders.length) { %><p>Chưa có đơn hàng.</p><% } latestOrders.forEach(order=>{ %><a class="row" href="/orders/<%= order.id %>"><strong>#<%= order.id %></strong><span><%= order.recipient %></span><span><%= labels[order.status] %></span><span><%= money(order.total) %></span></a><% }); %></section>
