<h1>Thông báo của bạn</h1><p>Thông báo có hàng/giảm giá được bật cho từng cấu hình tại trang sản phẩm. Cập nhật được kiểm tra định kỳ khoảng 30 giây hoặc khi mở trang này.</p>
<% if(watches.length) { %><section class="panel"><h2>Cấu hình đang theo dõi</h2><% watches.forEach(watch=>{ %><div class="row"><span><%= watch.name %> · <%= watch.sku %> · <%= watch.stock_enabled?'Có hàng ':'' %><%= watch.price_enabled?'Giảm giá':'' %></span><form method="post" action="/watches/<%= watch.variant_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="stock_enabled" value="0"><input type="hidden" name="price_enabled" value="0"><button class="secondary">Tắt theo dõi</button></form></div><% }); %></section><% } %>
<section class="panel"><h2>Cài đặt đơn hàng</h2><form method="post" action="/notifications/preferences"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= preferences.version %>"><label>Cập nhật tiến trình đơn hàng<select name="orders_enabled"><option value="1" <%= preferences.orders_enabled?'selected':'' %>>Bật</option><option value="0" <%= !preferences.orders_enabled?'selected':'' %>>Tắt</option></select></label><button>Lưu cài đặt</button></form></section>
<form method="post" action="/notifications/read/all"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Đánh dấu tất cả đã đọc</button></form>
<% if(!rows.length) { %><p>Chưa có thông báo mới.</p><% } rows.forEach(notification=>{ %><article class="panel notification <%= notification.is_read?'':'unread' %>"><h2><a href="<%= notification.url %>"><%= notification.title %></a></h2><p><%= notification.body %></p><small><%= localDateTime(notification.created_at) %> · <%= notification.is_read?'Đã đọc':'Chưa đọc' %></small><% if(!notification.is_read) { %><form method="post" action="/notifications/read/<%= notification.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Đánh dấu đã đọc</button></form><% } %></article><% }); %>
<%- include('record-pagination',{recordLabel:'thông báo'}) %>
