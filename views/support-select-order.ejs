<a href="/support">← Các yêu cầu hỗ trợ của tôi</a><h1>Gửi yêu cầu cho nhân viên</h1><p class="configuration-help">Chọn đơn hàng cần hỗ trợ, sau đó nhập nội dung gửi cho cửa hàng.</p>
<form class="filters" method="get" action="/support/new"><label>Tìm đơn hàng<input name="q" value="<%= filters.q %>" maxlength="150" placeholder="Mã đơn hoặc người nhận"></label><button>Tìm đơn</button><% if(filters.q) { %><a href="/support/new">Xóa tìm kiếm</a><% } %></form>
<% if(!orders.length) { %><section class="empty-state"><h2><%= filters.q?'Không tìm thấy đơn phù hợp':'Bạn chưa có đơn hàng' %></h2><p><%= filters.q?'Thử tìm bằng mã đơn hoặc tên người nhận khác.':'Yêu cầu hỗ trợ hiện được gắn với đơn hàng theo phạm vi của website.' %></p><a class="button secondary" href="<%= filters.q?'/support/new':'/' %>"><%= filters.q?'Xem tất cả đơn':'Khám phá sản phẩm' %></a></section><% } %>
<% orders.forEach(order=>{ %><article class="panel support-list-card"><div class="order-list-heading"><strong>Đơn #<%= order.id %></strong><span class="order-status-badge"><%= labels[order.status] %></span></div><p><%= order.recipient %> · <%= money(order.total) %></p><p class="configuration-help"><%= localDateTime(order.created_at) %> (UTC+7)</p><a class="button" href="/support/new?order=<%= order.id %>">Hỗ trợ đơn #<%= order.id %></a></article><% }) %>
<%- include('record-pagination',{recordLabel:'đơn hàng'}) %>
