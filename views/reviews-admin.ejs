<h1>Kiểm duyệt đánh giá</h1><a href="/admin">← Quản lý</a><form class="filters" method="get" action="/admin/reviews"><label>Tìm tên sản phẩm/nội dung<input name="q" maxlength="100" value="<%= filters.q %>"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><% for(const [value,label] of [['PENDING','Chờ duyệt'],['APPROVED','Đã duyệt'],['HIDDEN','Đã ẩn'],['REJECTED','Từ chối']]) { %><option value="<%= value %>" <%= filters.status===value?'selected':'' %>><%= label %></option><% } %></select></label><button>Lọc</button></form>
<% rows.forEach(r=>{ %><section class="panel"><h2><%= r.name %> · <%= r.rating %>/5 sao</h2><p><%= r.customer_name %> · <%= r.sku_snapshot %> · <a href="/orders/<%= r.order_id %>">Đơn #<%= r.order_id %></a> (<%= labels[r.order_status] %>)</p><p class="review-content"><%= r.content %></p><p><%= {PENDING:'Chờ duyệt',APPROVED:'Đã duyệt',HIDDEN:'Đã ẩn',REJECTED:'Từ chối'}[r.status] %></p><form method="post" action="/admin/reviews/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= r.version %>"><label>Quyết định<select name="status"><option value="APPROVED">Duyệt công khai</option><option value="HIDDEN">Ẩn</option><option value="REJECTED">Từ chối</option></select></label><label>Lý do (bắt buộc khi ẩn/từ chối)<textarea name="reason" maxlength="300"><%= r.moderation_reason %></textarea></label><button>Lưu kiểm duyệt</button></form></section><% }) %><% if(!rows.length) { %><p>Không có đánh giá phù hợp.</p><% } %><%- include('record-pagination',{recordLabel:'đánh giá'}) %>
