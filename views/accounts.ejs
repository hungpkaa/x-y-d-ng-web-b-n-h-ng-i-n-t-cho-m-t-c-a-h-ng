<h1>Quản lý tài khoản</h1><a href="/admin">← Quản lý sản phẩm</a>
<section class="panel"><h2>Tạo tài khoản nhân viên</h2><form method="post" action="/admin/accounts"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="formgrid"><label>Họ tên<input name="name" minlength="2" maxlength="80" required></label><label>Email<input name="email" type="email" maxlength="150" required></label><label>Điện thoại<input name="phone" type="tel" pattern="0[0-9]{9}"></label><label>Mật khẩu ban đầu<input name="password" type="password" minlength="10" maxlength="128" autocomplete="new-password" required></label></div><button>Tạo nhân viên</button></form></section>
<form class="filters" method="get" action="/admin/accounts"><label>Tìm tên, email, điện thoại<input name="q" value="<%= filters.q %>" maxlength="150"></label><label>Vai trò<select name="role"><option value="">Tất cả</option><% for(const [value,label] of [['CUSTOMER','Khách hàng'],['STAFF','Nhân viên'],['ADMIN','Quản trị viên']]) { %><option value="<%= value %>" <%= filters.role===value?'selected':'' %>><%= label %></option><% } %></select></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>Hoạt động</option><option value="LOCKED" <%= filters.status==='LOCKED'?'selected':'' %>>Đã khóa</option></select></label><button>Lọc</button><a href="/admin/accounts">Xóa lọc</a></form>
<% accounts.forEach(account=>{ %><a class="row panel" href="/admin/accounts/<%= account.id %>"><strong><%= account.name %></strong><span><%= account.email %></span><span><%= {CUSTOMER:'Khách hàng',STAFF:'Nhân viên',ADMIN:'Quản trị viên'}[account.role] %></span><span><%= account.status==='ACTIVE'?'Hoạt động':'Đã khóa' %></span></a><% }) %><% if(!accounts.length) { %><p>Không có tài khoản phù hợp.</p><% } %>
<%- include('record-pagination',{recordLabel:'tài khoản'}) %>
