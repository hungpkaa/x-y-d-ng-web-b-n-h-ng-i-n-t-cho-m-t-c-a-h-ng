<label for="<%= inputId %>"><%= inputLabel %></label><div class="password-field"><input id="<%= inputId %>" type="password" name="<%= inputName %>" minlength="<%= newPassword?10:1 %>" maxlength="128" autocomplete="<%= newPassword?'new-password':'current-password' %>" required><button type="button" class="password-toggle" data-password-toggle aria-controls="<%= inputId %>" aria-pressed="false" hidden>Hiện</button></div>
