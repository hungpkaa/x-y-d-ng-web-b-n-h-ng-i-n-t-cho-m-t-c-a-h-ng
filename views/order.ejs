<%- include('shopping-steps',{step:'order'}) %>
<h1>Đơn hàng #<%= order.id %></h1><a href="<%= user.role==='CUSTOMER'?'/orders':'/admin/orders' %>">← Danh sách đơn</a>
<%- include('order-overview') %>
<% if(user.role==='CUSTOMER'?order.status==='PENDING':transitions[order.status].some(status=>!['SHIPPING','DELIVERED'].includes(status))) { %>
<section class="panel"><h2>Thao tác với đơn hàng</h2>
<% if(user.role==='CUSTOMER' && order.status==='PENDING') { %><form method="post" action="/orders/<%= order.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><label>Lý do hủy<textarea name="reason" minlength="3" maxlength="300" required></textarea></label><button>Hủy đơn hàng</button></form><% } %>
<% const allowedOrderTransitions=transitions[order.status].filter(status=>!['SHIPPING','DELIVERED'].includes(status)); if(user.role!=='CUSTOMER' && allowedOrderTransitions.length) { %><form method="post" action="/admin/orders/<%= order.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><label>Cập nhật trạng thái<select name="status"><% allowedOrderTransitions.forEach(status=>{ %><option value="<%= status %>"><%= labels[status] %></option><% }) %></select></label><label>Lý do/ghi chú xử lý<textarea name="reason" minlength="3" maxlength="300" required></textarea></label><button>Xác nhận cập nhật</button></form><% } %></section><% } %>
<% if(user.role==='ADMIN' && order.payment_method==='COD' && order.status==='DELIVERED' && order.payment_status==='UNPAID') { %><section class="panel"><h2>Ghi nhận tiền COD đã thu</h2><form method="post" action="/admin/orders/<%= order.id %>/cod"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><div class="formgrid"><label>Số tiền thực thu (VND)<input name="amount" type="number" value="<%= order.total %>" min="1" step="1" required></label><label>Mã chứng từ/đối soát<input name="reference" minlength="3" maxlength="100" required></label><label>Ghi chú đối soát<textarea name="note" minlength="3" maxlength="300" required></textarea></label></div><button>Xác nhận đã thu đủ tiền</button></form></section><% } %>
<% if(receipt) { %><section class="panel"><h2>Chứng từ COD</h2><p><%= receipt.reference %> · <%= money(receipt.amount) %> · <%= receipt.created_at %> UTC</p><p><%= receipt.note %></p></section><% } %>
<h2>Lịch sử xử lý</h2><% history.forEach(event=>{ %><section class="panel"><p><%= localDateTime(event.created_at) %> (UTC+7) · <%= event.previous_status?labels[event.previous_status]+' → ':'' %><%= labels[event.status] %> · <%= event.actor_id===null?(event.source==='PROVIDER'?'Cổng thanh toán':'Hệ thống'):(user.role==='CUSTOMER'?{CUSTOMER:'Khách hàng',STAFF:'Nhân viên',ADMIN:'Quản trị viên'}[event.actor_role]:event.actor_name) %></p><% if(event.note) { %><p><%= event.note %></p><% } %></section><% }) %>

<%- include('order-review-forms') %>
<%- include('order-actions') %>
<%- include('order-shipment') %>
