<h1>Đơn hàng #<%= order.id %></h1><a href="<%= user.role==='CUSTOMER'?'/orders':'/admin/orders' %>">← Danh sách đơn</a>
<section class="panel"><p><strong><%= labels[order.status] %></strong> · <%= order.payment_method %> · <%= {UNPAID:'Chưa thu tiền',PAID:'Đã thu tiền',REFUND_PENDING:'Chờ hoàn tiền',REFUNDED:'Đã hoàn tiền',PENDING:'Chờ thanh toán'}[order.payment_status]||order.payment_status %></p><p><%= order.recipient %> · <%= order.phone %></p><p><%= order.address %></p>
<% items.forEach(item=>{ %><p><%= item.name %> (<%= item.sku_snapshot %> · <%= item.configuration_snapshot %>) × <%= item.quantity %> — <%= money(item.price*item.quantity) %></p><% }) %><p>Tiền hàng: <%= money(order.subtotal) %> · Phí giao hàng: <%= money(order.shipping_fee) %></p><h2>Tổng: <%= money(order.total) %></h2>
<% if(user.role==='CUSTOMER' && order.status==='PENDING') { %><form method="post" action="/orders/<%= order.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><label>Lý do hủy<textarea name="reason" minlength="3" maxlength="300" required></textarea></label><button>Hủy đơn hàng</button></form><% } %>
<% if(user.role!=='CUSTOMER' && transitions[order.status].length) { %><form method="post" action="/admin/orders/<%= order.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><label>Cập nhật trạng thái<select name="status"><% transitions[order.status].forEach(status=>{ %><option value="<%= status %>"><%= labels[status] %></option><% }) %></select></label><label>Lý do/ghi chú xử lý<textarea name="reason" minlength="3" maxlength="300" required></textarea></label><button>Xác nhận cập nhật</button></form><% } %></section>
<% if(user.role==='ADMIN' && order.payment_method==='COD' && order.status==='DELIVERED' && order.payment_status==='UNPAID') { %><section class="panel"><h2>Ghi nhận tiền COD đã thu</h2><form method="post" action="/admin/orders/<%= order.id %>/cod"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><div class="formgrid"><label>Số tiền thực thu (VND)<input name="amount" type="number" value="<%= order.total %>" min="1" step="1" required></label><label>Mã chứng từ/đối soát<input name="reference" minlength="3" maxlength="100" required></label><label>Ghi chú đối soát<textarea name="note" minlength="3" maxlength="300" required></textarea></label></div><button>Xác nhận đã thu đủ tiền</button></form></section><% } %>
<% if(receipt) { %><section class="panel"><h2>Chứng từ COD</h2><p><%= receipt.reference %> · <%= money(receipt.amount) %> · <%= receipt.created_at %> UTC</p><p><%= receipt.note %></p></section><% } %>
<h2>Lịch sử xử lý</h2><% history.forEach(event=>{ %><section class="panel"><p><%= event.created_at %> UTC · <%= event.previous_status?labels[event.previous_status]+' → ':'' %><%= labels[event.status] %> · <%= user.role==='CUSTOMER'?{CUSTOMER:'Khách hàng',STAFF:'Nhân viên',ADMIN:'Quản trị viên'}[event.actor_role]:event.actor_name %></p><% if(event.note) { %><p><%= event.note %></p><% } %></section><% }) %>
