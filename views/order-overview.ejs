<% const steps=['PENDING','CONFIRMED','PREPARING','SHIPPING','DELIVERED'],current=steps.indexOf(order.status); %>
<section class="panel order-overview"><div class="section-heading"><div><small>THEO DÕI ĐƠN HÀNG</small><h2><%= labels[order.status] %></h2></div><span>Đặt lúc <%= localDateTime(order.created_at) %> (UTC+7)</span></div>
<% if(current>=0) { %><ol class="order-progress" aria-label="Tiến trình đơn hàng"><% steps.forEach((step,index)=>{ %><li class="<%= index<current?'complete':index===current?'current':'upcoming' %>" <%= index===current?'aria-current=step':'' %>><span aria-hidden="true"><%= index<current?'✓':index+1 %></span><strong><%= labels[step] %></strong></li><% }) %></ol><% } %>
<% if(order.status==='CANCELLED') { %><p class="checkout-payment-note">Đơn đã hủy. Nếu cửa hàng đã nhận tiền, khoản cần hoàn được theo dõi riêng bên dưới.</p><% } else if(order.status==='DELIVERY_FAILED') { %><p class="checkout-payment-note">Giao hàng không thành công và cửa hàng đã nhận lại hàng. Xem trạng thái thanh toán và hoàn tiền bên dưới.</p><% } else if(shipping.shipment?.status==='FAILED') { %><p class="checkout-payment-note">Lần giao gần nhất chưa thành công. Cửa hàng đang xử lý giao lại hoặc nhận hàng về.</p><% } %>
<div class="order-payment-state"><span>Thanh toán: <strong><%= {UNPAID:'Chưa thu tiền',PAID:'Đã thu tiền',REFUND_PENDING:'Chờ hoàn tiền',REFUNDED:'Đã hoàn tiền',PENDING:'Chờ thanh toán'}[order.payment_status]||order.payment_status %></strong></span><span><%= order.payment_method==='COD'?'COD — trả tiền khi nhận hàng':order.payment_method==='BANK_TRANSFER'?'Chuyển khoản ngân hàng':'VNPay sandbox — thử nghiệm' %></span></div>
<% if(order.payment_method==='COD'&&order.status==='DELIVERED'&&order.payment_status==='UNPAID') { %><p class="configuration-help">Đơn đã giao; cửa hàng chưa xác nhận đối soát tiền COD trên hệ thống.</p><% } %>
</section>
<div class="order-detail-layout"><section class="panel"><h2>Sản phẩm đã đặt</h2><ul class="checkout-items"><% items.forEach(item=>{ %><li><div><strong><%= item.name %></strong><small><%= item.configuration_snapshot||'Cấu hình tiêu chuẩn' %></small><small>Mã: <%= item.sku_snapshot %> · Số lượng: <%= item.quantity %></small><small>Đơn giá lúc đặt: <%= money(item.price) %></small></div><strong><%= money(item.price*item.quantity) %></strong></li><% }) %></ul><dl class="checkout-totals"><div><dt>Tiền hàng</dt><dd><%= money(order.subtotal) %></dd></div><div><dt>Giảm giá<% if(order.promotion_code) { %><small><%= order.promotion_code %></small><% } %></dt><dd>−<%= money(order.discount) %></dd></div><div><dt>Phí giao hàng</dt><dd><%= money(order.shipping_fee) %></dd></div><div class="checkout-grand-total"><dt>Tổng đơn hàng</dt><dd><%= money(order.total) %></dd></div></dl></section>
<section class="panel"><h2>Thông tin nhận hàng</h2><strong><%= order.recipient %></strong><p><%= order.phone %></p><p><%= order.address %></p><p class="configuration-help">Thông tin và giá được lưu tại thời điểm đặt đơn.</p><% if(user.role==='CUSTOMER') { %><a href="/support/new?order=<%= order.id %>">Liên hệ hỗ trợ về đơn này</a><% } %></section></div>
