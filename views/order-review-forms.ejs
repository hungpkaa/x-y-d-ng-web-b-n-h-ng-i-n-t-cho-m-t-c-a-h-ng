<% if(user.role==='CUSTOMER' && order.status==='DELIVERED') { %><section class="panel"><h2>Đánh giá sản phẩm đã nhận</h2><p>Đánh giá công khai sau khi ADMIN duyệt. Sửa nội dung sẽ cần duyệt lại.</p><% items.forEach(item=>{ const r=orderReviews.find(review=>review.order_item_id===item.id); %><details class="panel"><summary><%= item.name %> · <%= item.sku_snapshot %> — <%= r?'Sửa đánh giá':'Viết đánh giá' %></summary><% if(r) { %><p>Trạng thái: <%= {PENDING:'Chờ duyệt',APPROVED:'Đã duyệt',HIDDEN:'Đã ẩn',REJECTED:'Từ chối'}[r.status] %></p><% if(r.moderation_reason) { %><p>Lý do kiểm duyệt: <%= r.moderation_reason %></p><% } %><% } %><form method="post" action="/orders/<%= order.id %>/items/<%= item.id %>/review"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= r?.version||0 %>"><label>Số sao<select name="rating"><% for(let rating=5;rating>=1;rating--) { %><option value="<%= rating %>" <%= r?.rating===rating?'selected':'' %>><%= rating %>/5</option><% } %></select></label><label>Nội dung<textarea name="content" minlength="1" maxlength="2000" required><%= r?.content||'' %></textarea></label><button>Gửi đánh giá</button></form></details><% }) %></section><% } %>
