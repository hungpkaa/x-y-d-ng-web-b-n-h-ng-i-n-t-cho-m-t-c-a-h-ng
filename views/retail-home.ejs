<% const heroProducts=[...catalogGroups].sort((a,b)=>(/điện thoại|laptop/i.test(b.category)?1:0)-(/điện thoại|laptop/i.test(a.category)?1:0)).map(group=>group.products.find(p=>p.image_key)).filter(Boolean).slice(0,2); %>
<div class="retail-showcase">
  <nav class="home-category-menu" aria-label="Khám phá danh mục">
    <h2><%- include('ui-icon',{name:'grid'}) %> Danh mục sản phẩm</h2>
    <% storeCategories.forEach((c,i)=>{ %><a href="/?category=<%= encodeURIComponent(c.name) %>"><span class="category-number"><%= String(i+1).padStart(2,'0') %></span><strong><%= c.name %></strong><span>›</span></a><% }) %>
    <a href="/recommendations"><%- include('ui-icon',{name:'search'}) %><strong>Tìm theo ngân sách</strong><span>›</span></a>
    <a href="/compare"><%- include('ui-icon',{name:'compare'}) %><strong>So sánh sản phẩm</strong><span>›</span></a>
  </nav>
  <section class="retail-hero retail-shopping-hero">
    <div class="retail-hero-copy"><span class="hero-kicker"><span></span> THẾ GIỚI CÔNG NGHỆ TRONG TẦM TAY</span><h1><%= store.title %></h1><p><%= store.subtitle %></p><div class="hero-shopping-tags"><span>Điện thoại</span><span>Laptop</span><span>Phụ kiện</span></div><a class="button hero-button" href="#catalog-products">Khám phá sản phẩm <span>→</span></a><small>Chọn thiết bị. So sánh cấu hình. Mua sắm dễ dàng.</small></div>
    <% if(heroProducts.length) { %><div class="hero-product-stage" aria-label="Khám phá thiết bị"><span class="hero-stage-orbit"></span><% heroProducts.forEach((p,i)=>{ %><a class="hero-product-tile hero-product-tile-<%= i %>" href="/products/<%= p.id %>"><span><%= p.category %></span><img src="/media/<%= p.image_key %>" alt="<%= p.name %>" width="200" height="200" fetchpriority="<%= i===0?'high':'auto' %>"><strong><%= p.name %></strong></a><% }); %></div><% } else { %><div class="hero-empty-art" aria-hidden="true"><%- include('ui-icon',{name:'box'}) %><span>KẾT NỐI<br><strong>MỌI TRẢI NGHIỆM.</strong></span></div><% } %>
  </section>
</div>
<% if(catalogGroups.length) { %><section class="home-category-discovery" aria-labelledby="home-category-title"><div class="discovery-title"><div><span class="retail-eyebrow">BẮT ĐẦU TỪ ĐIỀU BẠN CẦN</span><h2 id="home-category-title">Bạn đang tìm thiết bị nào?</h2></div><a href="#catalog-products">Khám phá tất cả <span>↗</span></a></div><div class="home-category-tiles"><% catalogGroups.forEach(group=>{const cover=group.products.find(p=>p.image_key); %><a href="/?category=<%= encodeURIComponent(group.category) %>#catalog-products"><div class="category-tile-image"><% if(cover) { %><img src="/media/<%= cover.image_key %>" alt="" loading="lazy" width="100" height="100"><% } else { %><%- include('ui-icon',{name:'grid'}) %><% } %></div><strong><%= group.category %></strong><span><%= group.paging.total %> sản phẩm <b>→</b></span></a><% }); %></div></section><% } %>
