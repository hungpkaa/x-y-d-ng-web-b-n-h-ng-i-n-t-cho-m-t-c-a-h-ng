<h1><%= management ? 'Quản lý đơn hàng' : 'Đơn hàng của tôi' %></h1><% if(management) { %><a href="/admin">← Quản lý sản phẩm</a><% } %>
<form class="filters" method="get" action="<%= management?'/admin/orders':'/orders' %>"><label>Mã đơn, người nhận, điện thoại<input name="q" value="<%= filters.q %>" maxlength="150"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><% Object.entries(labels).forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.status===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Từ ngày (UTC)<input type="date" name="from" value="<%= filters.from %>"></label><label>Đến ngày (UTC)<input type="date" name="to" value="<%= filters.to %>"></label><button>Lọc đơn</button><a href="<%= management?'/admin/orders':'/orders' %>">Xóa lọc</a></form>
<% if(!orders.length) { %><p>Không có đơn phù hợp.</p><% } %><% orders.forEach(o=>{ %><a class="row panel" href="/orders/<%= o.id %>"><strong>Đơn #<%= o.id %></strong><span><%= o.recipient %><br><small><%= o.created_at %> UTC</small></span><span><%= labels[o.status] %></span><strong><%= money(o.total) %></strong></a><% }) %>
<%- include('record-pagination',{recordLabel:'đơn hàng'}) %>
