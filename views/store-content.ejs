<h1>Nội dung cửa hàng</h1><section class="panel"><form method="post" action="/admin/content"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= store.version %>"><label>Tiêu đề banner<input name="title" maxlength="100" value="<%= store.title %>" required></label><label>Nội dung banner<textarea name="subtitle" maxlength="300" required><%= store.subtitle %></textarea></label><label>Thông tin liên hệ<textarea name="contact" maxlength="300"><%= store.contact %></textarea></label><button>Lưu nội dung</button></form></section>
