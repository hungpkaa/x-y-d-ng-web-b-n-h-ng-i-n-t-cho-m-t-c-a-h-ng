<h1>#<%= ticket.id %> · <%= ticket.subject %></h1><a href="<%= management?'/admin/support':'/support' %>">← Danh sách hỗ trợ</a> · <a href="/orders/<%= ticket.order_id %>">Đơn #<%= ticket.order_id %></a><p>Trạng thái: <%= {OPEN:'Mới',IN_PROGRESS:'Đang xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đã đóng'}[ticket.status] %><% if(management) { %> · Người xử lý: <%= ticket.assigned_name||'Chưa có' %><% } %></p>
<% messages.forEach(message=>{ %><article class="panel"><strong><%= message.actor_role==='CUSTOMER'?'Khách hàng':message.actor_name %><%= message.internal?' · Ghi chú nội bộ':'' %></strong><small> · <%= localDateTime(message.created_at) %> (UTC+7)</small><p class="message-content"><%= message.content %></p></article><% }) %>
<%- include('record-pagination',{recordLabel:'tin nhắn'}) %>
<% if(ticket.status!=='CLOSED') { %><section class="panel"><h2>Gửi tin</h2><form method="post" action="/support/<%= ticket.id %>/messages"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= ticket.version %>"><label>Nội dung<textarea name="content" maxlength="2000" required></textarea></label><% if(management) { %><label>Phạm vi<select name="internal"><option value="0">Trả lời khách hàng</option><option value="1">Ghi chú nội bộ</option></select></label><% } %><button>Gửi tin nhắn</button></form></section><% } %>
<% if(management) { const options={OPEN:['IN_PROGRESS','CLOSED'],IN_PROGRESS:['RESOLVED','CLOSED'],RESOLVED:['IN_PROGRESS','CLOSED'],CLOSED:['OPEN']}[ticket.status]; %><section class="panel"><h2>Tiến trình xử lý</h2><p>Khi cập nhật, bạn trở thành người xử lý yêu cầu.</p><form method="post" action="/support/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= ticket.version %>"><label>Bước tiếp theo<select name="status"><% options.forEach(code=>{ %><option value="<%= code %>"><%= {OPEN:'Mở lại',IN_PROGRESS:'Nhận xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đóng'}[code] %></option><% }) %></select></label><label>Lý do<textarea name="reason" minlength="3" maxlength="300" required></textarea></label><button>Cập nhật</button></form></section><% } else if(ticket.status==='CLOSED') { %><form method="post" action="/support/<%= ticket.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= ticket.version %>"><input type="hidden" name="status" value="OPEN"><p>Bạn có thể mở lại trong 7 ngày kể từ khi đóng.</p><button>Mở lại yêu cầu</button></form><% } %>
<h2>Lịch sử trạng thái</h2><% history.forEach(row=>{ %><p><%= localDateTime(row.created_at) %> · <%= {OPEN:'Mới',IN_PROGRESS:'Đang xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đã đóng'}[row.status] %><% if(management&&row.note) { %> · <%= row.note %><% } %></p><% }) %>
