<a href="/admin">← Danh sách quản lý</a><h1><%= product.name %></h1><p>Trạng thái: <strong><%= {DRAFT:'Bản nháp',ACTIVE:'Đang bán',HIDDEN:'Đã ẩn'}[product.status] %></strong></p>
<% if(user.role==='ADMIN') { %><a href="/admin/attributes">Định nghĩa thông số theo danh mục</a><% } %><%- include('product-images-admin') %>
<section class="panel"><h2>Thông tin sản phẩm</h2>
<form method="post" action="/admin/products"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= product.id %>"><input type="hidden" name="version" value="<%= product.version %>"><div class="formgrid"><label>Tên<input name="name" value="<%= product.name %>" maxlength="120" required></label><%- include('catalog-fields',{product}) %><label>Mô tả<textarea name="description" maxlength="2000" required><%= product.description %></textarea></label></div><button>Lưu thông tin</button></form>
<% if(user.role==='ADMIN') { %><form method="post" action="/admin/products/<%= product.id %>/publish"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= product.version %>"><label>Trạng thái bán<select name="status"><option value="ACTIVE" <%= product.status==='ACTIVE'?'selected':'' %>>Công bố</option><option value="HIDDEN" <%= product.status==='HIDDEN'?'selected':'' %>>Ẩn sản phẩm</option></select></label><button>Cập nhật trạng thái</button></form><% } %>
</section>
<section class="panel"><h2>Thêm SKU</h2><form method="post" action="/admin/products/<%= product.id %>/variants"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="formgrid"><label>Mã SKU<input name="sku" maxlength="80" placeholder="PHONE-BLACK-128" pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,79}" required></label><label>Màu<input name="color" maxlength="80"></label><label>Cấu hình<textarea name="configuration" maxlength="2000"></textarea></label></div><button>Thêm SKU chưa có giá</button></form></section>
<h2>Các SKU</h2>
<% if(!variants.length) { %><p>Chưa có SKU. Hãy thêm màu/cấu hình ở trên.</p><% } %>
<% variants.forEach(v=>{ %><section class="panel"><h3><%= v.sku %> · <%= v.color || 'Tiêu chuẩn' %></h3><p><%= v.configuration %></p><p>Giá: <strong><%= v.price===null?'Chưa đặt giá':money(v.price) %></strong> · <%= v.active?'Đã bật bán':'Chưa bật bán' %></p><p>Tồn vật lý: <%= v.on_hand %> · Đang giữ: <%= v.reserved %> · Có thể bán: <%= v.stock %></p>
<details><summary>Sửa màu, cấu hình và mã SKU</summary><form method="post" action="/admin/products/<%= product.id %>/variants"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= v.id %>"><input type="hidden" name="version" value="<%= v.version %>"><div class="formgrid"><label>Mã SKU<input name="sku" value="<%= v.sku %>" maxlength="80" required></label><label>Màu<input name="color" value="<%= v.color %>" maxlength="80"></label><label>Cấu hình<textarea name="configuration" maxlength="2000"><%= v.configuration %></textarea></label></div><button>Lưu SKU</button></form></details>
<%- include('variant-attributes',{v}) %>
<% if(user.role==='ADMIN') { %><form method="post" action="/admin/variants/<%= v.id %>/price"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= v.version %>"><div class="formgrid"><label>Giá (VND)<input name="price" type="number" min="1" max="1000000000" value="<%= v.price ?? '' %>" required></label><label>Trạng thái SKU<select name="active"><option value="0" <%= !v.active?'selected':'' %>>Chưa bật bán</option><option value="1" <%= v.active?'selected':'' %>>Bật bán</option></select></label></div><button>Lưu giá và trạng thái SKU</button></form><% } %>
<form method="post" action="/admin/variants/<%= v.id %>/stock"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= v.version %>"><div class="formgrid"><label>Điều chỉnh tồn (+ tăng, - giảm)<input name="delta" type="number" min="-1000000" max="1000000" required></label><label>Lý do<input name="reason" minlength="2" maxlength="300" required></label></div><button>Điều chỉnh tồn</button></form>
</section><% }) %>
<h2>Lịch sử tồn kho gần nhất</h2><% if(!movements.length) { %><p>Chưa có điều chỉnh.</p><% } %>
<% movements.forEach(m=>{ %><article class="panel"><strong><%= m.sku %></strong><p><%= m.reason %></p><small><%= m.created_at %> UTC · Tồn vật lý: <%= m.on_hand_delta>0?'+':'' %><%= m.on_hand_delta %> · Giữ hàng: <%= m.reserved_delta>0?'+':'' %><%= m.reserved_delta %></small></article><% }) %>
