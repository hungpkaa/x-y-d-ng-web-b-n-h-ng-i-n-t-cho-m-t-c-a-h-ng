<section aria-labelledby="admin-product-list-heading"><div class="section-heading"><h2 id="admin-product-list-heading">Danh sách sản phẩm</h2><span><%= paging.total %> sản phẩm · Trang <%= paging.page %>/<%= paging.pages %></span></div>
<details class="catalog-filter-panel" open><summary>Tìm kiếm và bộ lọc</summary><%- include('product-filters',{management:true}) %></details>
<% if(!products.length) { %><div class="empty-state"><h3>Không có sản phẩm phù hợp</h3><p>Thử đổi bộ lọc hoặc tạo sản phẩm nháp mới.</p><a class="button secondary" href="/admin">Xóa bộ lọc</a></div><% } else { %>
<div class="report-table-scroll"><table class="report-table admin-product-table"><thead><tr><th>Sản phẩm</th><th>Danh mục / thương hiệu</th><th>Trạng thái</th><th>Giá cấu hình từ</th><th>Tồn khả dụng</th><th>Thao tác</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><a class="admin-product-name" href="/admin/products/<%= p.id %>"><% if(p.image_key) { %><img src="/media/<%= p.image_key %>" alt="" loading="lazy" width="48" height="48"><% } %><span><strong><%= p.name %></strong><small>Mã sản phẩm #<%= p.id %></small></span></a></td><td><%= p.category %><br><small><%= p.brand %></small></td><td><span class="order-status-badge <%= p.status==='ACTIVE'?'':'order-status-muted' %>"><%= {DRAFT:'Bản nháp',ACTIVE:'Đang bán',HIDDEN:'Đã ẩn'}[p.status] %></span></td><td><%= p.price>0?money(p.price):'Chưa đặt giá' %></td><td><%= p.stock===null?'Chưa có SKU bật bán':p.stock %></td><td><a class="button secondary" href="/admin/products/<%= p.id %>">Thông tin và SKU →</a></td></tr><% }) %></tbody></table></div><% } %>
<%- include('pagination') %></section>
