<section class="recommendation-section" aria-label="Gợi ý sản phẩm"><h2><%= recommendation.heading %></h2>
<% if(recommendation.source&&recommendation.anchor) { %><p>Tham chiếu: <%= recommendation.source.name %> · <%= recommendation.anchor.sku %> · <%= money(recommendation.anchor.price) %>.</p><% } %>
<% if(!recommendation.products.length) { %><p>Chưa có sản phẩm còn hàng phù hợp. Hãy đổi bộ lọc hoặc <a href="/">xem toàn bộ sản phẩm</a>.</p><% } else { %><div class="grid"><% recommendation.products.forEach(p=>{ %><article class="card"><div class="product-art"><% if(p.image_key) { %><img src="/media/<%= p.image_key %>" alt="<%= p.name %>" loading="lazy"><% } else { %><span aria-label="Chưa có ảnh">&#128241;</span><% } %></div><small><%= p.brand %> · <%= p.category %></small><h3><a href="/products/<%= p.id %>?sku=<%= p.variant_id %>#sku-<%= p.variant_id %>"><%= p.name %></a></h3><p><%= [p.color,p.configuration].filter(Boolean).join(' · ')||p.sku %></p><strong class="price"><%= money(p.price) %></strong><p>Còn <%= p.stock %> sản phẩm ở cấu hình này</p><ul class="recommendation-reasons"><% p.reasons.forEach(reason=>{ %><li><%= reason %></li><% }) %></ul><a class="button" href="/products/<%= p.id %>?sku=<%= p.variant_id %>#sku-<%= p.variant_id %>">Xem cấu hình</a></article><% }) %></div><% } %>
</section>
