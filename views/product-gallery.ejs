<section class="product-gallery" data-gallery>
  <div class="gallery-stage"><img class="gallery-main" src="/media/<%= images[0].storage_key %>" alt="<%= images[0].alt_text||product.name %>" width="560" height="380"><button type="button" class="gallery-enlarge secondary" data-gallery-open hidden>⤢ Xem ảnh lớn</button></div>
  <div class="gallery-controls" data-gallery-controls hidden><button type="button" class="secondary" data-gallery-prev aria-label="Ảnh trước">←</button><span data-gallery-counter aria-live="polite">1 / <%= images.length %></span><button type="button" class="secondary" data-gallery-next aria-label="Ảnh tiếp theo">→</button></div>
  <div class="gallery-thumbnails"><% images.forEach((image,i)=>{ %><button type="button" class="secondary" data-image="/media/<%= image.storage_key %>" data-alt="<%= image.alt_text||product.name %>" aria-pressed="<%= i===0 %>" aria-label="Xem ảnh <%= i+1 %>"><img src="/media/<%= image.storage_key %>" alt="" width="70" height="60" loading="lazy"></button><% }) %></div>
  <dialog class="gallery-lightbox" data-gallery-dialog aria-labelledby="gallery-dialog-title"><div class="gallery-lightbox-heading"><h2 id="gallery-dialog-title"><%= product.name %></h2><button type="button" class="secondary" data-gallery-close aria-label="Đóng ảnh lớn" autofocus>✕</button></div><div class="gallery-lightbox-stage"><img data-gallery-large alt="" width="1200" height="900"></div><div class="gallery-lightbox-footer"><button type="button" class="secondary" data-gallery-prev aria-label="Ảnh trước">←</button><p data-gallery-caption aria-live="polite"></p><button type="button" class="secondary" data-gallery-next aria-label="Ảnh tiếp theo">→</button></div><small class="gallery-keyboard-hint">Dùng phím ← → để chuyển ảnh · Esc để đóng</small></dialog>
</section>
