<nav class="product-breadcrumb" aria-label="Đường dẫn"><a href="/">Sản phẩm</a><span aria-hidden="true">/</span><a href="/?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a><span aria-hidden="true">/</span><span><%= product.name %></span></nav>
<section class="panel product-intro"><small><%= product.brand %> · <%= product.category %></small><h1><%= product.name %></h1><div class="product-section-links"><a href="#product-configurations">Chọn cấu hình (<%= variants.length %>)</a><a href="#product-description">Thông tin sản phẩm</a><a href="#reviews">Đánh giá</a></div></section>
<% if(String(product.description||'').startsWith('DỮ LIỆU MẪU')) { %><p class="product-sample-alert"><strong>Sản phẩm mẫu.</strong> Giá, tồn kho và cấu hình chỉ phục vụ thử nghiệm, không phải báo giá bán thực tế.</p><% } %><div class="product-detail-showcase"><div class="product-detail-gallery"><% if(images.length) { %><%- include('product-gallery') %><% } else { %><section class="product-gallery product-gallery-empty"><%- include('discovery-placeholder') %><p>Chưa có ảnh sản phẩm</p></section><% } %>
</div><%- include('product-purchase-summary') %></div>

<section id="product-configurations" aria-labelledby="configuration-heading"><h2 id="configuration-heading">Chọn màu và cấu hình</h2><p class="configuration-help">Giá và số lượng còn hàng áp dụng riêng cho từng cấu hình. Chọn cấu hình bên dưới để xem thông số và đặt mua.</p>
<nav class="sku-picker" aria-label="Chọn cấu hình sản phẩm"><% variants.forEach(v=>{ %><a href="/products/<%= product.id %>?sku=<%= v.id %>#sku-<%= v.id %>" <%= recommendation.anchor?.id===v.id?'aria-current=true':'' %>><strong><%= [v.color,v.configuration].filter(Boolean).join(' · ')||v.sku %></strong><span><%= money(v.price) %> · <%= v.stock>0?'Có hàng':'Tạm hết hàng' %></span></a><% }) %></nav>
<div class="grid sku-grid"><% variants.forEach(v=>{ %>
  <article id="sku-<%= v.id %>" class="panel <%= recommendation.anchor?.id===v.id?'selected-sku':'' %>"><h3><%= v.color || 'Cấu hình tiêu chuẩn' %></h3><p><%= v.configuration %></p><small>Mã: <%= v.sku %></small><h2 class="price"><%= money(v.price) %></h2><p class="stock-status <%= v.stock>0?'in-stock':'out-of-stock' %>"><%= v.stock>0?'Còn '+v.stock+' sản phẩm':'Tạm hết hàng · Vẫn có thể xem và so sánh' %></p>
    <form method="post" action="/compare/add"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= v.id %>"><button class="secondary" <%= comparisonIds.includes(v.id)?'disabled':'' %>><%= comparisonIds.includes(v.id)?'Đã thêm vào so sánh':'Thêm vào so sánh' %></button></form>
    <a href="/products/<%= product.id %>?sku=<%= v.id %>#sku-<%= v.id %>">Xem gợi ý theo cấu hình này</a>
    <% if(v.attributes.length) { %><dl class="specs"><% v.attributes.forEach(d=>{ %><dt><%= d.label %></dt><dd><%= d.data_type==='NUMBER'?(d.value_number===null?'Chưa có thông tin':d.value_number+(d.unit?' '+d.unit:'')):d.data_type==='BOOLEAN'?(d.value_boolean===null?'Chưa có thông tin':d.value_boolean?'Có':'Không'):(d.value_text??'Chưa có thông tin') %></dd><% }) %></dl><% } %>
    <% if(!user||user.role==='CUSTOMER') { %><form method="post" action="/cart"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= v.id %>"><input type="hidden" name="action" value="add"><%- include('quantity-control',{value:1,min:1,max:Math.max(1,Math.min(v.stock,99)),quantityLabel:'Số lượng'}) %><button <%= v.stock>0 ? '' : 'disabled' %>>Thêm vào giỏ hàng</button></form><% } else { %><p class="configuration-help">Dùng tài khoản khách hàng riêng để mua sản phẩm.</p><% } %>
    <%- include('sku-watch',{v}) %>
  </article>
<% }) %></div>
<% if(!variants.length) { %><div class="empty-state"><p>Chưa có cấu hình đang bán.</p><a href="/">Xem sản phẩm khác</a></div><% } %></section>
<section class="panel product-description-panel" id="product-description" aria-labelledby="product-description-title"><span class="detail-section-kicker">TÌM HIỂU THÊM</span><h2 id="product-description-title">Thông tin sản phẩm</h2><p><%= product.description %></p></section><%- include('public-reviews') %>
<%- include('recommendation-cards') %>
<a class="button secondary" href="/recommendations?source=<%= product.id %><% if(recommendation.anchor) { %>&amp;sku=<%= recommendation.anchor.id %><% } %>">Lọc gợi ý theo ngân sách</a>
