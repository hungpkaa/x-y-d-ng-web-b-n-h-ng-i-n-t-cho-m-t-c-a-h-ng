<section class="panel narrow"><h1>Thông tin nhận hàng</h1><p>Tiền hàng: <%= money(subtotal) %></p><% if(promotionCode) { %><p>Mã giảm: <%= promotionCode %> · Giảm: <%= money(discount) %></p><% } %><p>Phí giao hàng: <%= money(shippingFee) %></p><p>Tổng thanh toán: <strong><%= money(total) %></strong></p>
<form method="get" action="/checkout"><label>Mã giảm giá<input name="code" value="<%= promotionCode %>" maxlength="40" pattern="[A-Za-z0-9_-]{3,40}"></label><label>Phương thức<select name="method"><option value="COD" <%= method==='COD'?'selected':'' %>>COD — trả tiền khi nhận hàng</option><% if(onlineAvailable) { %><option value="ONLINE" <%= method==='ONLINE'?'selected':'' %>>VNPay sandbox — thử nghiệm</option><% } %></select></label><% if(addressBook.length) { %><label>Địa chỉ đã lưu<select name="address"><% addressBook.forEach(entry=>{ %><option value="<%= entry.id %>" <%= selectedAddress.id===entry.id?'selected':'' %>><%= entry.label %> · <%= entry.recipient %></option><% }) %></select></label><% } %><button class="secondary">Áp dụng lựa chọn</button></form>
<p><%= method==='COD'?'COD — trả tiền khi nhận hàng.':'Đặt đơn rồi thanh toán VNPay sandbox trong 15 phút.' %></p><a href="/addresses">Quản lý địa chỉ</a>
<form method="post" action="/checkout"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="code" value="<%= promotionCode %>"><input type="hidden" name="method" value="<%= method %>"><label>Người nhận<input name="recipient" value="<%= selectedAddress.recipient %>" minlength="2" maxlength="80" autocomplete="name" required></label><label>Số điện thoại<input name="phone" type="tel" value="<%= selectedAddress.phone %>" pattern="0[0-9]{9}" placeholder="0901234567" autocomplete="tel" required></label><label>Địa chỉ<textarea name="address" minlength="10" maxlength="300" autocomplete="street-address" required><%= selectedAddress.address %></textarea></label><button>Xác nhận đặt hàng</button></form></section>
