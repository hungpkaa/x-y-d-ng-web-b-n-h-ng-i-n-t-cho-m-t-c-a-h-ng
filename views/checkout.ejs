<%- include('shopping-steps',{step:'checkout'}) %>
<nav class="product-breadcrumb" aria-label="Đường dẫn"><a href="/cart">Giỏ hàng</a><span aria-hidden="true">/</span><span>Xác nhận đặt hàng</span></nav>
<h1>Xác nhận đặt hàng</h1><p class="configuration-help">Kiểm tra cấu hình, thông tin nhận hàng và tổng tiền trước khi đặt.</p>
<div class="checkout-layout"><div class="checkout-details"><section class="panel"><h2>1. Lựa chọn thanh toán</h2><p class="configuration-help">Đổi phương thức để xem hướng dẫn thanh toán. Nhấn “Áp dụng lựa chọn” sau khi nhập mã giảm giá.</p>
<form method="post" action="/checkout/options" data-checkout-options><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Mã giảm giá<input name="code" value="<%= promotionCode %>" maxlength="40" pattern="[A-Za-z0-9_-]{3,40}"></label><label>Phương thức<select name="method"><option value="COD" <%= method==='COD'?'selected':'' %>>COD — trả tiền khi nhận hàng</option><option value="BANK_TRANSFER" <%= method==='BANK_TRANSFER'?'selected':'' %>>Chuyển khoản ngân hàng (BIDV)</option><% if(onlineAvailable) { %><option value="ONLINE" <%= method==='ONLINE'?'selected':'' %>>VNPay sandbox — thử nghiệm</option><% } %></select></label><% if(addressBook.length) { %><label>Địa chỉ đã lưu<select name="address"><% addressBook.forEach(entry=>{ %><option value="<%= entry.id %>" <%= selectedAddress.id===entry.id?'selected':'' %>><%= entry.label %> · <%= entry.recipient %></option><% }) %></select></label><% } %><button class="secondary">Áp dụng lựa chọn</button></form>
<%- include('payment-choice-cards') %>
<% if(method==='BANK_TRANSFER') { %><%- include('checkout-bank-preview') %><% } %>
<p class="checkout-payment-note"><%= method==='COD'?'COD — trả tiền khi nhận hàng.':method==='BANK_TRANSFER'?'Chuyển khoản BIDV. Đơn chờ ADMIN xác nhận tiền trong 30 phút từ khi tạo.':'Đặt đơn rồi thanh toán VNPay sandbox trong 15 phút. Đây là thanh toán thử nghiệm.' %></p><a href="/addresses">Quản lý địa chỉ</a></section>
<section class="panel"><h2>2. Thông tin nhận hàng</h2>
<form id="place-order-form" method="post" action="/checkout"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="code" value="<%= promotionCode %>"><input type="hidden" name="method" value="<%= method %>"><label>Người nhận<input name="recipient" value="<%= checkoutDraft.recipient??selectedAddress.recipient %>" minlength="2" maxlength="80" autocomplete="name" required></label><label>Số điện thoại<input name="phone" type="tel" value="<%= checkoutDraft.phone??selectedAddress.phone %>" pattern="0[0-9]{9}" placeholder="0901234567" autocomplete="tel" required></label><input type="hidden" name="delivery_source_address" value="<%= selectedAddress.id||'' %>"><%- include('regional-address-fields',{value:checkoutDraft.address??selectedAddress.address,draft:checkoutDraft}) %><p class="configuration-help">Thông tin này được lưu trên đơn để giao hàng. Kiểm tra số nhà, đường và phường/xã trước khi xác nhận.</p></form></section></div>
<aside class="panel checkout-summary" aria-labelledby="checkout-summary-heading"><h2 id="checkout-summary-heading">3. Kiểm tra đơn hàng</h2><a href="/cart">Sửa sản phẩm trong giỏ</a>
<ul class="checkout-items"><% items.forEach(item=>{ %><li><%- include('cart-product-image',{item}) %><div><strong><%= item.name %></strong><small><%= [item.color,item.configuration].filter(Boolean).join(' · ')||item.sku %></small><small>Mã: <%= item.sku %> · Số lượng: <%= item.quantity %></small><small>Đơn giá: <%= money(item.price) %></small></div><strong><%= money(item.price*item.quantity) %></strong></li><% }) %></ul>
<dl class="checkout-totals"><div><dt>Tiền hàng</dt><dd><%= money(subtotal) %></dd></div><div><dt>Giảm giá<% if(promotionCode) { %><small><%= promotionCode %></small><% } %></dt><dd>−<%= money(discount) %></dd></div><div><dt>Phí giao hàng</dt><dd><%= money(shippingFee) %></dd></div><div class="checkout-grand-total"><dt>Tổng thanh toán</dt><dd><%= money(total) %></dd></div></dl>
<p class="configuration-help">Phương thức đã áp dụng: <strong><%= method==='COD'?'COD':method==='BANK_TRANSFER'?'Chuyển khoản BIDV':'VNPay sandbox' %></strong>. Giá, tồn kho và mã giảm giá sẽ được kiểm tra lại khi đặt.</p><button type="submit" form="place-order-form"><%= method==='COD'?'Xác nhận đặt hàng':'Đặt hàng và tiếp tục thanh toán' %></button></aside></div>
