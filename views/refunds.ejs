<h1>Ghi nhận hoàn tiền</h1><a href="/admin">← Quản lý</a><p>Chỉ xác nhận sau khi bạn đã hoàn tiền qua ngân hàng hoặc cổng thanh toán. Mỗi khoản thu được hoàn toàn bộ một lần; cần mã đối soát và bằng chứng. Đây là ghi nhận chứng từ, không tự gửi lệnh hoàn tiền.</p>
<% if(!rows.length) { %><p>Không có khoản cần hoàn.</p><% } %><% rows.forEach(row=>{ %><section class="panel"><h2>Đơn #<%= row.order_id %> · <%= money(row.amount) %></h2><a href="/orders/<%= row.order_id %>">Xem đơn</a><p>Khoản thu #<%= row.id %> · <%= row.provider %> · <%= row.reference %> · <%= localDateTime(row.occurred_at) %> (UTC+7)</p><form method="post" action="/admin/payments/<%= row.id %>/refund"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= row.version %>"><label>Số tiền đã hoàn (VND)<input name="amount" type="number" value="<%= row.amount %>" min="1" step="1" required></label><label>Mã chứng từ hoàn<input name="reference" minlength="3" maxlength="100" required></label><label>Mã hoặc đường dẫn bằng chứng<input name="evidence_ref" minlength="3" maxlength="200" required></label><label>Thời điểm đã hoàn (giờ Việt Nam)<input name="occurred_at" type="datetime-local" step="1" required></label><label>Ghi chú đối soát<textarea name="note" minlength="3" maxlength="300" required></textarea></label><button>Xác nhận tiền đã hoàn</button></form></section><% }) %><%- include('record-pagination',{recordLabel:'khoản cần hoàn'}) %>
