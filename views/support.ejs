<h1><%= management?'Xử lý hỗ trợ':'Yêu cầu hỗ trợ của tôi' %></h1><a href="<%= management?'/admin':'/orders' %>">← <%= management?'Quản lý':'Đơn của tôi' %></a><p>Khách gửi yêu cầu từ trang chi tiết đơn hàng.</p><form class="filters" method="get"><label>Chủ đề<input name="q" maxlength="120" value="<%= filters.q %>"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><% for(const [code,label] of Object.entries({OPEN:'Mới',IN_PROGRESS:'Đang xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đã đóng'})) { %><option value="<%= code %>" <%= filters.status===code?'selected':'' %>><%= label %></option><% } %></select></label><button>Lọc</button></form>
<p class="catalog-result-summary"><%= paging.total %> yêu cầu phù hợp · Cập nhật gần nhất trước</p>
<% if(!rows.length) { %><section class="empty-state"><h2>Chưa có yêu cầu phù hợp</h2><p><%= management?'Thử đổi bộ lọc để xem yêu cầu cần xử lý.':'Bạn có thể gửi yêu cầu hỗ trợ từ trang chi tiết đơn hàng.' %></p><a class="button secondary" href="<%= management?'/admin/support':'/orders' %>"><%= management?'Xóa bộ lọc':'Xem đơn hàng của tôi' %></a></section><% } %><% rows.forEach(row=>{ %><article class="panel support-list-card"><div class="order-list-heading"><a href="/support/<%= row.id %>"><strong>#<%= row.id %> · <%= row.subject %></strong></a><span class="order-status-badge"><%= {OPEN:'Mới',IN_PROGRESS:'Đang xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đã đóng'}[row.status] %></span></div><p class="configuration-help">Đơn #<%= row.order_id %> · Cập nhật <%= localDateTime(row.updated_at) %> (UTC+7)</p><a class="button secondary" href="/support/<%= row.id %>">Xem hội thoại →</a></article><% }) %><%- include('record-pagination',{recordLabel:'yêu cầu'}) %>
