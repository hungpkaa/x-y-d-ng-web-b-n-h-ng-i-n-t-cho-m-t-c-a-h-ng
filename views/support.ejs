<h1><%= management?'Xử lý hỗ trợ':'Yêu cầu hỗ trợ của tôi' %></h1><a href="<%= management?'/admin':'/orders' %>">← <%= management?'Quản lý':'Đơn của tôi' %></a><p>Khách gửi yêu cầu từ trang chi tiết đơn hàng.</p><form class="filters" method="get"><label>Chủ đề<input name="q" maxlength="120" value="<%= filters.q %>"></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><% for(const [code,label] of Object.entries({OPEN:'Mới',IN_PROGRESS:'Đang xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đã đóng'})) { %><option value="<%= code %>" <%= filters.status===code?'selected':'' %>><%= label %></option><% } %></select></label><button>Lọc</button></form>
<% if(!rows.length) { %><p>Chưa có yêu cầu phù hợp.</p><% } %><% rows.forEach(row=>{ %><a class="row panel" href="/support/<%= row.id %>"><strong>#<%= row.id %> · <%= row.subject %></strong><span>Đơn #<%= row.order_id %></span><span><%= {OPEN:'Mới',IN_PROGRESS:'Đang xử lý',RESOLVED:'Đã giải quyết',CLOSED:'Đã đóng'}[row.status] %></span></a><% }) %><%- include('record-pagination',{recordLabel:'yêu cầu'}) %>
