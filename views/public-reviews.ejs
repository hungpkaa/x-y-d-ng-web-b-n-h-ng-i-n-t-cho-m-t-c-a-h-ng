<section id="reviews" class="panel"><h2>Đánh giá từ người đã nhận hàng</h2><% if(!reviews.summary.count) { %><p>Chưa có đánh giá được duyệt.</p><% } else { %><p><strong><%= reviews.summary.average.toFixed(1) %>/5</strong> từ <%= reviews.summary.count %> đánh giá đã duyệt.</p><% reviews.rows.forEach(r=>{ %><article class="panel"><strong><%= r.rating %>/5 sao · Đã nhận hàng</strong><p><%= r.sku_snapshot %> · <%= r.configuration_snapshot %></p><p class="review-content"><%= r.content %></p><small><%= r.updated_at %> UTC</small></article><% }) %><%- include('record-pagination',{paging:reviews.paging,recordLabel:'đánh giá'}) %><% } %></section>
