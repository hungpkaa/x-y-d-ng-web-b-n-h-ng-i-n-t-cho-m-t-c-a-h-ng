<% if(bankTransfer) { %><section id="bank-transfer" class="panel bank-transfer-panel"><h2>Chuyển khoản ngân hàng</h2>
<% if(order.status==='PENDING'&&['PENDING','UNPAID'].includes(order.payment_status)&&bankTransfer.expires_at>Date.now()) { %>
<p class="checkout-payment-note">Chờ cửa hàng xác nhận tiền trước <strong><%= new Date(bankTransfer.expires_at).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'}) %></strong> (giờ Việt Nam). Quét QR không tự xác nhận thanh toán.</p>
<% if(bankQrAvailable&&bankTransfer.bank_code==='BIDV'&&bankTransfer.account_number==='4801021854') { %><img class="bank-transfer-qr" src="/images/payments/bidv-4801021854.png" alt="QR tài khoản nhận tiền BIDV 4801021854"><p class="auth-hint">Đối chiếu người nhận trong ứng dụng ngân hàng. Với QR tĩnh, nhập đúng số tiền và nội dung bên dưới.</p><% } else { %><p class="auth-hint">Chưa có ảnh QR đã đối chiếu. Bạn có thể dùng thông tin chuyển khoản bên dưới.</p><% } %>
<dl class="checkout-totals"><div><dt>Ngân hàng</dt><dd><%= bankTransfer.bank_code %></dd></div><div><dt>Số tài khoản</dt><dd><%= bankTransfer.account_number %></dd></div><div><dt>Chủ tài khoản</dt><dd><%= bankTransfer.account_name %></dd></div><div><dt>Số tiền</dt><dd><%= money(bankTransfer.amount) %></dd></div><div><dt>Nội dung chuyển khoản</dt><dd><strong><%= bankTransfer.transfer_reference %></strong></dd></div></dl>
<p class="configuration-help">Không chuyển thêm nếu bạn đã chuyển tiền. Nếu cửa hàng chưa kịp xác nhận trước hạn, hãy liên hệ hỗ trợ đơn hàng.</p>
<% } else { %><p>Trạng thái khoản chuyển: <strong><%= {PAID:'Đã xác nhận đủ tiền',REFUND_PENDING:'Chờ hoàn tiền',REFUNDED:'Đã hoàn tiền'}[order.payment_status]||'Đơn đã hết hạn hoặc không còn chờ chuyển khoản' %></strong>. Không chuyển thêm tiền theo đơn này.</p><% } %>
<% if(bankReceipts.length) { %><div class="bank-receipt-summary"><h3>Khoản chuyển đã đối soát</h3><% bankReceipts.forEach(record=>{ %><p><strong><%= money(record.amount) %></strong> · Nhận lúc <%= localDateTime(record.occurred_at) %> (UTC+7)</p><small>ADMIN ghi nhận lúc <%= localDateTime(record.created_at) %> (UTC+7)</small><% }) %></div><% } else if(order.status==='PENDING') { %><a class="button secondary" href="/orders/<%= order.id %>#bank-transfer">Kiểm tra lại trạng thái</a><% } %>
<% if(user.role==='ADMIN'&&['PENDING','CANCELLED','DELIVERY_FAILED'].includes(order.status)&&['PENDING','UNPAID'].includes(order.payment_status)) { %><details><summary>ADMIN: đối soát khoản tiền thực nhận</summary><p class="auth-hint">Kiểm tra giao dịch tại ngân hàng trước khi xác nhận. Tiền được xác nhận sau hạn sẽ ghi chờ hoàn, không mở lại đơn.</p><form method="post" action="/admin/orders/<%= order.id %>/bank-transfer"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= order.version %>"><label>Số tiền nhận<input name="amount" type="number" value="<%= bankTransfer.amount %>" min="1" step="1" required></label><label>Mã giao dịch ngân hàng<input name="reference" pattern="[A-Za-z0-9_-]{3,100}" required></label><label>Thời điểm nhận tiền (giờ Việt Nam)<input type="datetime-local" name="occurred_at" step="1" required></label><label>Ghi chú đối soát<textarea name="note" minlength="3" maxlength="300" required></textarea></label><button>Xác nhận đã nhận đủ tiền</button></form></details><% } %></section><% } %>
