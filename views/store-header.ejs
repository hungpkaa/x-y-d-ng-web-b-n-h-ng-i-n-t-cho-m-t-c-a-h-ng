<a class="skip-link" href="#main-content">Đến nội dung</a>
<div class="service-strip"><span>Electro Store · Công nghệ cho cuộc sống</span><span>Chọn cấu hình · So sánh · Đặt hàng thuận tiện</span></div>
<header class="store-header"><a class="logo" href="/" aria-label="Electro Store trang chủ"><span class="logo-mark">E</span><span>Electro<span class="logo-light">Store</span></span></a>
<form class="header-search" action="/" method="get" role="search"><input name="q" placeholder="Bạn đang tìm thiết bị gì?" aria-label="Tìm sản phẩm" maxlength="100"><button aria-label="Tìm kiếm">⌕</button></form>
<nav class="header-actions" aria-label="Tài khoản và giỏ hàng"><% if(!user||user.role==='CUSTOMER') { %><a href="/cart">Giỏ hàng <b><%= cartCount %></b></a><% } %><% if(user) { %><a href="<%= user.role==='CUSTOMER'?'/orders':'/admin/dashboard' %>"><%= user.role==='CUSTOMER'?'Đơn của tôi':'Quản lý' %></a><details class="account-menu"><summary><%= user.name %></summary><div><a href="/profile">Hồ sơ của tôi</a><% if(user.role==='CUSTOMER') { %><a href="/favorites">Yêu thích</a><a href="/notifications">Thông báo (<%= unreadNotifications %>)</a><a href="/addresses">Địa chỉ</a><a href="/support">Hỗ trợ</a><% } %><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Đăng xuất</button></form></div></details><% } else { %><a href="/login">Đăng nhập</a><a href="/register">Đăng ký</a><% } %></nav></header>
<div class="category-bar"><nav aria-label="Danh mục"><a href="/">Tất cả sản phẩm</a><% storeCategories.forEach(c=>{ %><a href="/?category=<%= encodeURIComponent(c.name) %>"><%= c.name %></a><% }) %><a href="/compare">So sánh (<%= comparisonCount %>)</a><a href="/recommendations">Gợi ý cho bạn</a><a href="/recent">Đã xem</a></nav></div>
