<article class="card product-card"><a class="product-art" href="/products/<%= p.id %>"><% if(p.image_key) { %><img src="/media/<%= p.image_key %>" alt="<%= p.name %>" loading="lazy" width="220" height="190"><% } else { %><span class="device-placeholder" aria-label="Chưa có ảnh"><svg viewBox="0 0 80 100" aria-hidden="true"><rect x="18" y="4" width="44" height="90" rx="9" fill="none" stroke="currentColor" stroke-width="3"/><path d="M31 12h18M36 86h8" stroke="currentColor" stroke-width="3"/><path d="M24 60 55 22v48H24Z" fill="currentColor" opacity=".12"/></svg></span><% } %></a><small><%= p.brand %> · <%= p.category %></small><h2><a href="/products/<%= p.id %>"><%= p.name %></a></h2><p class="product-description"><%= p.description %></p><div class="product-price"><span>Từ</span> <strong class="price"><%= money(p.price) %></strong></div><p class="stock-status <%= p.stock>0?'in-stock':'out-of-stock' %>"><%= p.stock>0?'Có hàng · Chọn cấu hình để xem tồn':'Tạm hết hàng' %></p><a class="button secondary" href="/products/<%= p.id %>"><%= p.stock>0?'Chọn cấu hình':'Xem sản phẩm' %></a></article>
