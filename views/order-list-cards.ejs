<% const filtered=Boolean(filters.q||filters.status||filters.from||filters.to); %>
<p class="catalog-result-summary"><%= paging.total %> đơn hàng<%= filtered?' phù hợp bộ lọc':'' %> · Mới nhất trước</p>
<% if(!orders.length) { %>
<section class="empty-state"><h2><%= filtered?'Không có đơn phù hợp':'Bạn chưa có đơn hàng' %></h2><p><%= filtered?'Thử đổi trạng thái, khoảng ngày hoặc từ khóa tìm kiếm.':'Khám phá sản phẩm và chọn cấu hình phù hợp để đặt đơn đầu tiên.' %></p><a class="button secondary" href="<%= filtered?(management?'/admin/orders':'/orders'):'/' %>"><%= filtered?'Xóa bộ lọc':'Khám phá sản phẩm' %></a></section>
<% } %>
<div class="order-list"><% orders.forEach(o=>{ %>
<article class="panel order-list-card"><div class="order-list-heading"><a href="/orders/<%= o.id %>"><strong>Đơn #<%= o.id %></strong></a><span class="order-status-badge <%= o.status==='CANCELLED'||o.status==='DELIVERY_FAILED'?'order-status-muted':'' %>"><%= labels[o.status] %></span></div>
<p class="configuration-help">Đặt lúc <%= localDateTime(o.created_at) %> (UTC+7)</p>
<div class="order-list-body"><div><p>Người nhận: <strong><%= o.recipient %></strong></p><p><%= o.payment_method==='COD'?'COD — trả tiền khi nhận hàng':'VNPay sandbox — thử nghiệm' %></p><p>Thanh toán: <strong><%= {UNPAID:'Chưa thu tiền',PENDING:'Chờ thanh toán',PAID:'Đã thu tiền',REFUND_PENDING:'Chờ hoàn tiền',REFUNDED:'Đã hoàn tiền'}[o.payment_status]||o.payment_status %></strong></p></div><div class="order-list-total"><small>Tổng đơn hàng</small><strong><%= money(o.total) %></strong><a class="button secondary" href="/orders/<%= o.id %>" aria-label="Xem chi tiết đơn #<%= o.id %>">Xem chi tiết →</a></div></div>
</article><% }) %></div>
