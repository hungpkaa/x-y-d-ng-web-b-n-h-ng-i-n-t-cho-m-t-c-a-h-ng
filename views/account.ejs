<h1>Tài khoản: <%= account.name %></h1><a href="/admin/accounts">← Danh sách tài khoản</a>
<section class="panel"><p>Email: <%= account.email %></p><p>Vai trò: <%= {CUSTOMER:'Khách hàng',STAFF:'Nhân viên',ADMIN:'Quản trị viên'}[account.role] %> · <%= account.status==='ACTIVE'?'Hoạt động':'Đã khóa' %></p>
<% if(account.role==='STAFF') { %><form method="post" action="/admin/accounts/<%= account.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= account.version %>"><div class="formgrid"><label>Họ tên<input name="name" value="<%= account.name %>" minlength="2" maxlength="80" required></label><label>Điện thoại<input name="phone" value="<%= account.phone %>" type="tel" pattern="0[0-9]{9}"></label></div><button>Lưu thông tin nhân viên</button></form><% } %></section>
<% if(account.id!==user.id) { %><section class="panel"><h2><%= account.status==='ACTIVE'?'Khóa tài khoản':'Mở khóa tài khoản' %></h2><form method="post" action="/admin/accounts/<%= account.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= account.version %>"><input type="hidden" name="status" value="<%= account.status==='ACTIVE'?'LOCKED':'ACTIVE' %>"><label>Lý do<textarea name="reason" minlength="3" maxlength="300" required></textarea></label><button><%= account.status==='ACTIVE'?'Khóa tài khoản':'Mở khóa tài khoản' %></button></form></section><% } else { %><p>Bạn đang sử dụng tài khoản này.</p><% } %>
