<% const categoryUrl=(changes={})=>{ const params=new URLSearchParams({category,q,brand,min,max,sort,...changes});for(const [key,value] of [...params]) if(value==='')params.delete(key);return '/?'+params.toString()+'#catalog-products';}; %>
<nav class="product-breadcrumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">›</span><strong><%= category %></strong></nav>
<% if(paging.page===1) { %><div class="category-spotlight category-theme-<%= categoryDesign.theme %>"><section class="category-hero"><div class="category-hero-copy"><span class="category-eyebrow"><%= categoryDesign.eyebrow %></span><h1><%= categoryDesign.title %></h1><p><%= categoryDesign.description %></p><a class="button" href="#catalog-products">Khám phá <%= category.toLowerCase() %> <span>→</span></a><small><%= categoryDesign.note %></small></div>
<div class="category-art" aria-hidden="true"><span class="category-art-orbit orbit-one"></span><span class="category-art-orbit orbit-two"></span><% if(categoryDesign.theme==='laptop') { %><div class="category-laptop"><div class="laptop-display"><div class="laptop-wallpaper"></div><span class="laptop-camera"></span><span class="laptop-screen-copy">Create.<br>Connect.<br><strong>Anywhere.</strong></span></div><div class="laptop-base"></div></div><span class="category-floating-tag">YOUR IDEAS.<br><strong>NO LIMITS.</strong></span><% } else if(categoryDesign.theme==='phone') { %><div class="category-phone category-phone-rear"><span class="category-camera"></span><span class="category-camera second-camera"></span><span class="category-camera third-camera"></span></div><div class="category-phone category-phone-main"><span class="category-dynamic-island"></span><div class="category-phone-wallpaper"></div><span class="category-phone-copy">Hello,<br><strong>new day.</strong></span></div><span class="category-floating-tag">YOUR DAY.<br><strong>YOUR WAY.</strong></span><% } else { %><div class="category-headphones"><span></span><i></i><b></b></div><span class="category-floating-tag">MAKE EVERY<br><strong>MOMENT COUNT.</strong></span><% } %></div></section>
<aside class="category-discovery"><span class="category-eyebrow">CHỌN DỄ HƠN</span><h2>Cấu hình nào<br>dành cho bạn?</h2><p>Đặt các lựa chọn cạnh nhau để nhìn rõ điểm khác biệt.</p><a href="/compare"><%- include('ui-icon',{name:'compare'}) %> So sánh cấu hình <span>↗</span></a><a href="/recommendations"><%- include('ui-icon',{name:'search'}) %> Gợi ý theo ngân sách <span>↗</span></a><small>Chỉ cần chọn thiết bị bạn quan tâm, chưa cần quyết định ngay.</small></aside></div><% } %>
<section class="category-discovery-filters" aria-label="Lựa chọn nhanh theo danh mục"><div class="category-brand-heading"><div><span class="category-eyebrow">BẮT ĐẦU TỪ THƯƠNG HIỆU BẠN THÍCH</span><h2>Khám phá <%= category.toLowerCase() %></h2></div><a href="<%= categoryUrl({brand:'',min:'',max:'',q:''}) %>">Xem tất cả →</a></div>
<nav class="category-brand-grid" aria-label="Thương hiệu <%= category %>"><a class="category-brand-pill <%= !brand?'selected':'' %>" href="<%= categoryUrl({brand:''}) %>" <%= !brand?'aria-current=page':'' %>>Tất cả</a><% brands.forEach(entry=>{ %><a class="category-brand-pill <%= brand===entry.brand?'selected':'' %>" href="<%= categoryUrl({brand:entry.brand}) %>" <%= brand===entry.brand?'aria-current=page':'' %>><%= entry.brand %></a><% }) %></nav>
<div class="category-budget-row"><strong>Chọn theo giá</strong><% categoryDesign.budgets.forEach(([label,lower,upper])=>{ const chosen=min===String(lower)&&max===String(upper); %><a class="<%= chosen?'selected':'' %>" href="<%= categoryUrl({min:String(lower),max:String(upper)}) %>" <%= chosen?'aria-current=page':'' %>><%= label %></a><% }) %></div></section>
