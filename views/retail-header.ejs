<a class="skip-link" href="#main-content">Đến nội dung</a>
<div class="service-strip"><span>Chọn đúng cấu hình · Mua sắm thuận tiện</span><span>So sánh thông số rõ ràng</span><span>Theo dõi đơn ngay trên tài khoản</span></div>
<div class="retail-header-wrap"><header class="store-header"><a class="logo" href="/" aria-label="Electro Store trang chủ"><span class="logo-mark">e</span><span>electro<span class="logo-light">store</span><small>Thiết bị cho cuộc sống</small></span></a>
<details class="header-categories"><summary><%- include('ui-icon',{name:'grid'}) %><span>Danh mục</span></summary><nav aria-label="Danh mục nhanh"><% storeCategories.forEach(c=>{ %><a href="/?category=<%= encodeURIComponent(c.name) %>"><%= c.name %><span>›</span></a><% }) %><a href="/">Tất cả sản phẩm →</a></nav></details>
<form class="header-search" action="/" method="get" role="search"><input name="q" value="<%= typeof q==='string'?q:'' %>" placeholder="Bạn muốn mua gì hôm nay?" aria-label="Tìm sản phẩm" maxlength="100"><button aria-label="Tìm kiếm"><%- include('ui-icon',{name:'search'}) %></button></form>
<nav class="header-actions" aria-label="Tài khoản và giỏ hàng"><a class="header-order-link" href="<%= user&&user.role!=='CUSTOMER'?'/admin/dashboard':'/orders' %>"><%- include('ui-icon',{name:'box'}) %><span><%= user&&user.role!=='CUSTOMER'?'Quản lý':'Tra cứu' %><br><strong><%= user&&user.role!=='CUSTOMER'?'cửa hàng':'đơn hàng' %></strong></span></a>
<% if(!user||user.role==='CUSTOMER') { %><a class="header-cart-link" href="/cart"><%- include('ui-icon',{name:'cart'}) %><span>Giỏ hàng</span><b><%= cartCount %></b></a><% } %>
<% if(user) { %><details class="account-menu"><summary><%- include('ui-icon',{name:'user'}) %><span><%= user.name %></span></summary><div><strong>Xin chào, <%= user.name %></strong><a href="/profile">Hồ sơ của tôi</a><% if(user.role==='CUSTOMER') { %><a href="/orders">Đơn của tôi</a><a href="/favorites">Yêu thích</a><a href="/notifications">Thông báo (<%= unreadNotifications %>)</a><a href="/addresses">Sổ địa chỉ</a><a href="/support">Yêu cầu hỗ trợ</a><% } else { %><a href="/admin">Quản lý cửa hàng</a><% } %><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="secondary">Đăng xuất</button></form></div></details><% } else { %><a class="header-login-link" href="/login"><%- include('ui-icon',{name:'user'}) %><span>Đăng nhập</span></a><% } %></nav></header>
<div class="category-bar"><nav aria-label="Danh mục"><a href="/">Tất cả sản phẩm</a><% storeCategories.forEach(c=>{ %><a href="/?category=<%= encodeURIComponent(c.name) %>"><%= c.name %></a><% }) %><a href="/compare">So sánh (<%= comparisonCount %>)</a><a href="/recommendations">Gợi ý cho bạn</a><a href="/recent">Đã xem</a></nav></div></div>
