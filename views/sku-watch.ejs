<% if(user?.role==='CUSTOMER') { const watch=productWatches.find(w=>w.variant_id===v.id); %><details><summary>Theo dõi có hàng / giảm giá</summary><form method="post" action="/watches/<%= v.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Khi có hàng trở lại<select name="stock_enabled"><option value="0">Tắt</option><option value="1" <%= watch?.stock_enabled?'selected':'' %>>Bật</option></select></label><label>Khi giá giảm<select name="price_enabled"><option value="0">Tắt</option><option value="1" <%= watch?.price_enabled?'selected':'' %>>Bật</option></select></label><button class="secondary">Lưu theo dõi</button></form></details><% } %>
