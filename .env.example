# Copy to .env; never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
# PostgreSQL: when DATABASE_URL is set, the application uses PostgreSQL.
# URL-encode special characters in the username/password. Never share real credentials.
# DATABASE_URL=postgresql://electro_store_app:YOUR_PASSWORD@localhost:5432/electro_store
# DATABASE_SCHEMA=public
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# SESSION_SECRET=replace-with-a-stable-random-secret-for-production
# Set only behind the trusted reverse proxy that you control (HTTPS production).
# TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://postgres:09062004@localhost:5432/electro_store
# Password recovery via SMTP. Both APP_URL and SMTP settings must be configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# VNPay SANDBOX credentials issued for your merchant/domain.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Register the public IPN URL with VNPay: APP_URL/payments/vnpay/ipn
# Return URL: APP_URL/payments/vnpay/return
